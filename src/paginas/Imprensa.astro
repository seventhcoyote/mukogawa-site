---
/**
 * Sala de imprensa.
 *
 * Fica fora do cabeçalho de propósito — quem chega aqui vem do rodapé, e é
 * público de trabalho, não leitor. O que a página faz é evitar a troca de
 * e-mails que hoje seria obrigatória para qualquer veículo publicar algo.
 *
 * Onde o arquivo ainda não existe, o item aparece marcado "em breve" em vez de
 * um link que não baixa. É a mesma regra dos perfis inertes no rodapé: lugar
 * reservado honesto vale mais que link morto.
 */
import Base from "../layouts/Base.astro";
import { IMPRENSA } from "../i18n/conteudo/imprensa";
import { EMAILS } from "../config/site";
import { rota } from "../i18n/idiomas";
import type { Idioma } from "../i18n/idiomas";

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const c = IMPRENSA[idioma];
const sinopses = c.sinopses.filter((s) => s.texto.trim());
---

<Base titulo={c.titulo} descricao={c.descricao}>
  <section class="secao secao--curta">
    <span class="selo-fundo" aria-hidden="true">報</span>
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">{c.rotulo}</p></div>
        <h1>{c.titulo}</h1>
        <p class="lead">{c.lead}</p>
      </div>
    </div>
  </section>

  <section class="secao secao--curta">
    <div class="envelope duas">
      <div>
        <div class="cabecalho-secao"><h2>{c.fichaTitulo}</h2></div>
        <dl class="ficha">
          {c.ficha.map((f) => (<><dt>{f.rotulo}</dt><dd>{f.valor}</dd></>))}
        </dl>
      </div>

      <div>
        <div class="cabecalho-secao"><h2>{c.sinopseTitulo}</h2></div>
        <p class="nota">{c.sinopseNota}</p>
        {sinopses.map((s) => (
          <div class="sinopse">
            <p class="rotulo">{s.rotulo}</p>
            <p class="texto">{s.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="secao secao--curta materiais">
    <div class="envelope">
      <div class="cabecalho-secao">
        <h2>{c.materialTitulo}</h2>
        <p class="lead">{c.materialLead}</p>
      </div>

      <div class="blocos">
        {c.materiais.map((b) => (
          <div class="bloco">
            <p class="rotulo">{b.titulo}</p>
            <ul>
              {b.itens.map((i) => (
                <li>
                  {i.href ? (
                    <a href={i.href} download>
                      <span class="nome">{i.nome}</span>
                      <span class="detalhe">{i.detalhe}</span>
                    </a>
                  ) : (
                    <span class="inerte">
                      <span class="nome">{i.nome}</span>
                      <span class="detalhe">{i.detalhe} — {c.emBreve}</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="secao secao--curta">
    <div class="envelope duas">
      <div>
        <div class="cabecalho-secao"><h2>{c.usoTitulo}</h2></div>
        <ul class="uso">{c.uso.map((u) => (<li>{u}</li>))}</ul>
      </div>

      <div>
        <div class="cabecalho-secao"><h2>{c.creditoTitulo}</h2></div>
        <p class="nota">{c.creditoLead}</p>
        <p class="credito">{c.creditoLinha}</p>
      </div>
    </div>
  </section>

  <section class="secao secao--curta contato">
    <div class="envelope">
      <div class="cabecalho-secao"><h2>{c.contatoTitulo}</h2></div>
      <p class="lead">{c.contatoTexto}</p>
      <a class="botao" href={`mailto:${EMAILS.imprensa}`}>{c.contatoBotao}</a>
      <p class="endereco">{EMAILS.imprensa}</p>
    </div>
  </section>
</Base>

<style>
  .secao { position: relative; overflow: hidden; }
  .selo-fundo {
    position: absolute;
    right: -4%; top: 50%;
    transform: translateY(-50%);
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(10rem, 26vw, 22rem);
    line-height: 1;
    color: #fff;
    opacity: .03;
    user-select: none;
    pointer-events: none;
  }
  .envelope { position: relative; }

  .duas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .ficha {
    display: grid;
    grid-template-columns: minmax(120px, auto) 1fr;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--linha);
  }
  .ficha dt, .ficha dd {
    margin: 0;
    padding: 11px 0;
    border-bottom: 1px solid var(--linha);
  }
  .ficha dt {
    font-family: var(--fonte-ui);
    font-size: .74rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--poeira);
    padding-right: 20px;
  }
  .ficha dd { color: var(--osso); font-size: .96rem; }

  .nota { color: var(--poeira); font-size: .92rem; margin: 0 0 22px; }
  .sinopse + .sinopse { margin-top: 26px; }
  .sinopse .rotulo { margin-bottom: 8px; }
  .sinopse .texto { margin: 0; color: var(--cinza); max-width: 62ch; }

  .materiais { background: var(--tinta-2); border-block: 1px solid var(--linha); }
  .blocos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: clamp(24px, 3vw, 40px);
  }
  .bloco .rotulo { margin-bottom: 14px; }
  .bloco ul { list-style: none; margin: 0; padding: 0; }
  .bloco li + li { border-top: 1px solid var(--linha); }
  .bloco a, .bloco .inerte {
    display: grid;
    gap: 3px;
    min-height: 56px;            /* alvo de toque */
    padding: 11px 0;
    align-content: center;
    text-decoration: none;
  }
  .bloco a { color: var(--osso); transition: color .2s ease; }
  .bloco a:hover { color: var(--sangue-vivo); }
  .bloco .nome { font-size: .95rem; }
  .bloco .detalhe {
    font-family: var(--fonte-ui);
    font-size: .72rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--poeira);
  }
  .bloco .inerte { color: var(--poeira); cursor: default; }

  .uso { margin: 0; padding-left: 18px; color: var(--cinza); max-width: 60ch; }
  .uso li + li { margin-top: 12px; }

  .credito {
    margin: 0;
    padding: 18px 20px;
    background: var(--vazio);
    border: 1px solid var(--linha-forte);
    border-left: 2px solid var(--sangue);
    font-size: .9rem;
    line-height: 1.7;
    color: var(--cinza);
    user-select: all;            /* clicar seleciona a linha inteira */
  }

  .contato .lead { max-width: 56ch; margin-bottom: clamp(24px, 3vw, 32px); }
  .contato .endereco {
    margin: 18px 0 0;
    font-family: var(--fonte-ui);
    font-size: .82rem;
    letter-spacing: .12em;
    color: var(--poeira);
  }
</style>
