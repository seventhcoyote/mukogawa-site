---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Base from "../layouts/Base.astro";
import { personagensDoIdioma, ROTULOS_PERSONAGENS } from "../i18n/conteudo/personagens";
import { rota } from "../i18n/idiomas";
import type { Idioma } from "../i18n/idiomas";

interface Props { idioma: Idioma; slug: string }
const { idioma, slug } = Astro.props;

const rot = ROTULOS_PERSONAGENS[idioma];
const personagens = personagensDoIdioma(idioma);
const p = personagens.find((x) => x.slug === slug)!;
const base = rota("personagens", idioma);

const arquivos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/personagens/*.jpg",
  { eager: true },
);
const arte = arquivos[`../assets/personagens/${p.slug}.jpg`]!.default;

// Estudos e artes secundárias de cada personagem. Nada se repete entre páginas:
// cada arte do acervo aparece em exatamente um lugar do site.
const ESTUDOS: Record<string, string[]> = {
  gabriel: ["gabriel-estudos"],
  amunet: ["amunet-estudo"],
  miguel: ["miguel-estudos"],
  satis: ["satis", "satis-busto", "satis-estudo"],
  celeste: ["celeste-estudos"],
  ariel: ["ariel-estudos"],
  tesserion: ["tesserion-estudos"],
  kharzul: ["kharzul", "kharzul-estudos", "kharzul-corpo", "kharzul-manga-estudo", "kharzul-manga"],
  orthrax: ["orthrax-estudos"],
  helel: ["helel-estudos"],
  serafins: ["serafins-estudos"],
};

// Os estudos de traço solto NÃO passam pelo pipeline de imagem do Astro.
// Motivo medido: o WebP gerado por ele reintroduz 11% a 17% de ruído entre 1 e
// 29 no fundo, e sobre a seção em preto puro isso faz a arte inteira virar um
// retângulo mais claro. São servidos como PNG sem perda direto de public/,
// gerados por ferramentas/normalizar-estudos.mjs.
const galeriaArquivos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/estudos/*.jpg",
  { eager: true },
);
// Duas naturezas de arte convivem aqui, e elas não podem receber o mesmo
// tratamento. O traço do Bretas é branco sobre preto: some no fundo e flutua.
// As páginas do Match são PAINÉIS de mangá, com borda retangular própria —
// se tentarem flutuar, viram um retângulo colado. Esses ganham moldura de
// verdade, para a borda existir de propósito. Classificação conferida a olho,
// arte por arte.
const PAINEIS = new Set([
  "satis-busto", "satis-estudo", "satis",
]);

const galeria = (ESTUDOS[p.slug] ?? []).map((n) => {
  const painel = PAINEIS.has(n);
  return painel
    // painel de mangá: fundo claro, sem blend, o pipeline do Astro serve bem
    ? { nome: n, painel, arte: galeriaArquivos[`../assets/estudos/${n}.jpg`]?.default, png: null }
    // traço solto: PNG sem perda, servido cru
    : { nome: n, painel, arte: null, png: `/estudos/${n}.webp` };
}).filter((g) => g.arte || g.png);

const i = personagens.findIndex((x) => x.slug === p.slug);
const anterior = personagens[(i - 1 + personagens.length) % personagens.length];
const proximo = personagens[(i + 1) % personagens.length];

const ladoTexto = rot.lados[p.lado];
---

<Base
  titulo={p.nome}
  descricao={`${p.nome}, ${p.epiteto} — ${rot.classe} ${p.classeNum}, ${p.classe}. ${p.sobrePersonagem[0].slice(0, 130)}...`}
  og={`/og/${p.slug}.jpg`}
>
  <article data-lado={p.lado}>
    <!-- abertura em splash -->
    <header class="abertura">
      <div class="fundo" aria-hidden="true">
        <span class="aura"></span>
        <span class="selo">{p.kanji}</span>
      </div>

      <div class="envelope grade">
        <div class="retrato">
          <Image
            src={arte}
            alt={`${p.nome} — ${p.epiteto}`}
            widths={[420, 760, 1050]}
            sizes="(max-width: 880px) 88vw, 42vw"
            loading="eager"
            fetchpriority="high"
          />
          <span class="cantos" aria-hidden="true"></span>
        </div>

        <div class="ficha">
          <p class="rotulo rotulo--lado">{rot.classe} {p.classeNum} // {p.classe}</p>
          <h1>{p.nome}</h1>
          <p class="epiteto">{p.epiteto}</p>
          <p class="faccao"><span class="ponto" aria-hidden="true"></span>{ladoTexto}</p>
          <p class="credito">{p.credito}</p>
        </div>
      </div>
    </header>

    <section class="secao">
      <div class="envelope colunas">
        <div class="bloco">
          <div class="cabecalho-secao">
            <div class="topo"><p class="rotulo">{rot.ordem}</p></div>
            <h2>{p.classe}</h2>
          </div>
          <div class="corpo"><p>{p.sobreClasse}</p></div>
        </div>

        <div class="bloco">
          <div class="cabecalho-secao">
            <div class="topo"><p class="rotulo">{rot.oEterno}</p></div>
            <h2>{p.nome}</h2>
          </div>
          <div class="corpo">
            {p.sobrePersonagem.map((t) => <p>{t}</p>)}
          </div>
        </div>
      </div>
    </section>

    {galeria.length > 0 && (
      <section class="secao secao--curta galeria-bloco">
        <div class="envelope">
          <div class="cabecalho-secao">
            <div class="topo"><p class="rotulo">{rot.doCaderno}</p></div>
            <h2>{rot.estudos}</h2>
          </div>

          <div class:list={["galeria", { "galeria--unica": galeria.length === 1 }]}>
            {galeria.map((g, n) => (
              <figure class:list={{ painel: g.painel }}>
                {g.png ? (
                  <img src={g.png} alt={`${p.nome} — estudo ${n + 1}`} loading="lazy" decoding="async" />
                ) : (
                  <Image
                    src={g.arte!}
                    alt={`${p.nome} — estudo ${n + 1}`}
                    widths={[420, 820]}
                    sizes="(max-width: 760px) 92vw, 44vw"
                    loading="lazy"
                  />
                )}
              </figure>
            ))}
          </div>

          <p class="credito-galeria">{p.credito}</p>
        </div>
      </section>
    )}

    <nav class="passo" aria-label={rot.titulo}>
      <a class="anterior" href={`${base}/${anterior.slug}`}>
        <span class="dir">{rot.anterior}</span>
        <span class="nome">{anterior.nome}</span>
      </a>
      <a class="todos" href={base}>{rot.todosCurto}</a>
      <a class="proximo" href={`${base}/${proximo.slug}`}>
        <span class="dir">{rot.proximo}</span>
        <span class="nome">{proximo.nome}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .abertura {
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 6vw, 80px) clamp(40px, 6vw, 90px);
    border-bottom: 1px solid var(--linha);
  }
  .fundo { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .fundo .aura {
    position: absolute;
    left: -14%; top: -34%;
    width: 76%; height: 168%;
    background:
      radial-gradient(ellipse 48% 40% at 50% 50%, var(--lado-fundo), transparent 68%),
      radial-gradient(ellipse 26% 22% at 50% 52%, var(--lado), transparent 74%);
    opacity: .55;
  }
  .fundo .selo {
    position: absolute;
    right: -3%; top: 50%;
    transform: translateY(-50%);
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(14rem, 32vw, 32rem);
    line-height: 1;
    color: #fff;
    opacity: .03;
    user-select: none;
  }

  /* Sem z-index aqui, pelo mesmo motivo registrado na História: ele criava
     contexto de empilhamento e matava o mix-blend-mode do retrato, que voltava
     a pintar o próprio preto (0,0,0) sobre a --tinta (6,6,8) do fundo — um
     retângulo de degrau 6, seis vezes o pior caso que o projeto tolera.
     A ordem do DOM já basta: .fundo vem antes e fica atrás. */
  .grade {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 42%) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 70px);
    align-items: center;
  }

  .retrato { position: relative; max-width: 460px; }
  .retrato :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--vazio);
    mix-blend-mode: screen;
    clip-path: polygon(22px 0, 100% 0, 100% calc(100% - 22px), calc(100% - 22px) 100%, 0 100%, 0 22px);
  }
  .retrato .cantos {
    position: absolute; inset: -12px;
    pointer-events: none;
    background:
      linear-gradient(var(--lado), var(--lado)) 0 0 / 1px 46px no-repeat,
      linear-gradient(var(--lado), var(--lado)) 0 0 / 46px 1px no-repeat,
      linear-gradient(var(--lado), var(--lado)) 100% 100% / 1px 46px no-repeat,
      linear-gradient(var(--lado), var(--lado)) 100% 100% / 46px 1px no-repeat;
  }

  h1 { font-size: clamp(2.6rem, 6.4vw, 4.8rem); margin: 18px 0 14px; }

  .epiteto {
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: clamp(1rem, 2vw, 1.35rem);
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--osso);
    margin-bottom: 22px;
  }

  .faccao {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 26px;
    padding: 8px 16px;
    border: 1px solid var(--linha-forte);
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: .8rem;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: var(--lado);
  }
  .faccao .ponto { width: 8px; height: 8px; background: var(--lado); }

  .credito {
    margin: 0;
    font-family: var(--fonte-ui);
    font-size: .8rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--poeira);
  }

  .colunas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(30px, 5vw, 70px);
    align-items: start;
  }
  .bloco h2 { font-size: clamp(1.5rem, 2.6vw, 2.2rem); }

  /* ---------- estudos ---------- */
  /* Preto puro nesta seção, e as artes SEM mix-blend-mode.
     O blend fazia o preto da arte sumir, mas amplificava tudo que não fosse
     zero: JPEG e WebP reintroduzem 4% a 15% de ruído entre 1 e 29 no fundo
     depois de qualquer tratamento, e sob screen isso virava os blocos 8x8 da
     compressão. Com a seção em #000 e a arte com fundo #000, ela desaparece
     igual — e o ruído, sendo escuro sobre escuro, deixa de ser amplificado.
     Mais robusto que perseguir compressão sem perda arte por arte. */
  .galeria-bloco {
    border-top: 1px solid var(--linha);
    background: var(--vazio);
  }
  .galeria {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(16px, 2.4vw, 30px);
    align-items: start;
  }
  .galeria--unica { grid-template-columns: minmax(0, 780px); }
  /* traço solto: sem moldura nenhuma, o preto some e a arte flutua na página */
  .galeria figure {
    margin: 0;
    overflow: hidden;
  }
  .galeria :global(img),
  .galeria img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform .6s cubic-bezier(.16,.84,.28,1);
  }

  /* painel de mangá: a borda é inerente à arte, então vira moldura assumida */
  .galeria figure.painel {
    background: var(--vazio);
    border: 1px solid var(--linha-forte);
    padding: 10px;
    clip-path: polygon(16px 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%, 0 16px);
  }
  .galeria figure.painel :global(img) { mix-blend-mode: normal; }
  /* o painel de mangá tem fundo claro: sobre o preto puro da seção ele ganha
     respiro em vez de encostar */
  .galeria figure.painel { background: #050507; }

  .galeria figure:hover :global(img),
  .galeria figure:hover img { transform: scale(1.03); }
  .credito-galeria {
    margin: 22px 0 0;
    font-family: var(--fonte-ui);
    font-size: .78rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--poeira);
  }

  .passo {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    border-top: 1px solid var(--linha);
  }
  .passo a {
    display: grid;
    gap: 6px;
    padding: 28px var(--gutter);
    text-decoration: none;
    transition: background .25s ease;
  }
  .passo a:hover { background: var(--tinta-2); }
  .passo .dir {
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: .72rem;
    letter-spacing: .28em;
    text-transform: uppercase;
    color: var(--poeira);
  }
  .passo .nome {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--osso);
  }
  .passo .proximo { text-align: right; }
  .passo .todos {
    display: grid;
    place-items: center;
    border-inline: 1px solid var(--linha);
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: .78rem;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: var(--cinza);
  }

  @media (max-width: 880px) {
    .grade { grid-template-columns: 1fr; }
    .retrato { max-width: 420px; }
  }
  @media (max-width: 560px) {
    .passo { grid-template-columns: 1fr 1fr; }
    .passo .todos { grid-column: 1 / -1; border-inline: 0; border-top: 1px solid var(--linha); padding-block: 20px; }
  }
</style>
