---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import fontes from "../assets/historia/fontes-profanas.jpg";
import guerra from "../assets/historia/guerra-pela-humanidade.jpg";
import helelRosto from "../assets/historia/helel-rosto.png";

// As artes dos quatro lugares, ligadas pelo `id` do lugar e não pela posição no
// array — o texto muda de idioma, o id não.
//
// CUIDADO com o nome do arquivo original: o que chegou como "heaven" é HAVEN, a
// cidade oculta dos Rebeldes no submundo, e não os Altos Céus. Conferido pela
// imagem (caverna com cidade suspensa sobre água), não pelo nome do arquivo.
import arteAltosCeus from "../assets/historia/lugares/altos-ceus-gravura.jpg";
import arteHaven from "../assets/historia/lugares/haven-gravura.jpg";
import arteDeserto from "../assets/historia/lugares/deserto-gravura.jpg";
import arteVeilstrand from "../assets/historia/lugares/veilstrand-gravura.jpg";

// As mesmas quatro em cor, para o hover. Ficaram no repositório desde que o
// tratamento em traço entrou, justamente para poder voltar atrás — agora servem
// para as duas coisas.
import corAltosCeus from "../assets/historia/lugares/altos-ceus.jpg";
import corHaven from "../assets/historia/lugares/haven.jpg";
import corDeserto from "../assets/historia/lugares/deserto.jpg";
import corVeilstrand from "../assets/historia/lugares/veilstrand.jpg";

const ARTE_LUGAR = {
  "altos-ceus": arteAltosCeus,
  haven: arteHaven,
  deserto: arteDeserto,
  veilstrand: arteVeilstrand,
} as const;

const COR_LUGAR = {
  "altos-ceus": corAltosCeus,
  haven: corHaven,
  deserto: corDeserto,
  veilstrand: corVeilstrand,
} as const;
import { HISTORIA } from "../i18n/conteudo/historia";
import { ROTULOS_PERSONAGENS } from "../i18n/conteudo/personagens";
import { OBRA } from "../i18n/conteudo/obra";
import { rota } from "../i18n/idiomas";
import type { Idioma } from "../i18n/idiomas";

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const c = HISTORIA[idioma];
const hrefObra = rota("obra", idioma);
const rotuloObra = OBRA[idioma].h1;
const hrefPersonagens = rota("personagens", idioma);
// Reaproveita o rótulo que a home já usa para o mesmo destino: "Todos os
// personagens". Já está traduzido nos quatro idiomas, e dizer a mesma coisa
// para o mesmo lugar é o que faz o leitor reconhecer o caminho.
const rotuloPersonagens = ROTULOS_PERSONAGENS[idioma].todos;

const series = c.series;
---

<Base titulo={c.titulo} descricao={c.descricao}>
  <section class="secao abertura">
    <span class="selo-fundo" aria-hidden="true">戦</span>
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">{c.rotuloAbertura}</p></div>
        <h1>{c.h1}</h1>
      </div>

      <div class="corpo lead-corpo">
        <p>{c.aberturaP1}</p>
        <p>{c.aberturaP2}</p>
      </div>
    </div>
  </section>


  <section class="secao">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">{c.rotuloEternos}</p></div>
        <h2>{c.tituloEternos}</h2>
      </div>
      <div class="corpo">
        {c.eternosP.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <hr class="regua" />

  <!-- Aço para a Hoste, sangue para os Rebeldes: a cor carrega a informação,
       e é a mesma troca que os cards de personagem fazem por [data-lado]. -->
  <section class="secao">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">{c.rotuloLados}</p></div>
        <h2>{c.tituloLados}</h2>
      </div>

      <div class="lados">
        <div class="lado" data-lado="hoste">
          <p>{c.ladosP[0]}</p>
        </div>
        <div class="lado" data-lado="rebeldes">
          <p>{c.ladosP[1]}</p>
        </div>
      </div>

      <!-- O terceiro parágrafo fica FORA dos dois blocos: ele fala do nome que
           um lado dá ao outro, então não pertence a nenhum dos dois. Dentro do
           bloco vermelho ele ainda desequilibrava a coluna da Hoste, que ficava
           com metade do texto e um vazio embaixo. -->
      <p class="lados-fecho">{c.ladosP[2]}</p>
    </div>
  </section>

  <hr class="regua" />

  <section class="secao">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">{c.rotuloEras}</p></div>
        <h2>{c.tituloEras}</h2>
        <p class="lead">{c.leadEras}</p>
      </div>

      <ol class="eras">
        {c.eras.map((e) => (
          <li>
            <h3>{e.nome}</h3>
            <p>{e.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <hr class="regua" />

  {/* Depois das eras de propósito: a página diz QUANDO e só então ONDE.

      A cor segue carregando informação, como em "Os dois lados": os Altos Céus
      são da Hoste e levam aço, Haven é dos Rebeldes e leva sangue. O Deserto e
      o Veilstrand não pertencem a lado nenhum — são o chão onde os dois se
      encontram — e por isso ficam sem filete colorido. */}
  <section class="secao">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">{c.rotuloLugares}</p></div>
        <h2>{c.tituloLugares}</h2>
      </div>

      <div class="lugares">
        {c.lugares.map((l) => (
          <div class:list={["lugar", { "lugar--neutro": !l.lado }]} data-lado={l.lado}>
            <div class="arte arte--lugar">
              <Image src={ARTE_LUGAR[l.id]} alt={l.nome} widths={[520, 900, 1320]}
                     sizes="(max-width: 759px) 92vw, 46vw" loading="lazy" />
              {/* A mesma arte em cor, revelada no hover. `alt` vazio porque
                  descreve a mesma coisa que a de cima: para quem usa leitor de
                  tela seria a mesma informação lida duas vezes. */}
              <Image class="cor" src={COR_LUGAR[l.id]} alt="" aria-hidden="true"
                     widths={[520, 900, 1320]}
                     sizes="(max-width: 759px) 92vw, 46vw" loading="lazy" />
              <span class="cantos" aria-hidden="true"></span>
            </div>
            <h3>{l.nome}</h3>
            <p>{l.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <hr class="regua regua--corte" />

  <section class="secao">
    <div class="envelope duplo">
      <div class="arte">
        <Image src={fontes} alt={c.tituloPoco} widths={[520, 900]} sizes="(max-width: 900px) 92vw, 46vw" loading="lazy" />
        <span class="cantos" aria-hidden="true"></span>
      </div>
      <div>
        <div class="cabecalho-secao">
          <div class="topo"><p class="rotulo">{c.rotuloPreco}</p></div>
          <h2>{c.tituloPoco}</h2>
        </div>
        <div class="corpo">
          {c.pocoP.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <hr class="regua regua--corte" />

  <section class="secao">
    <div class="envelope duplo duplo--invertido">
      <div>
        <div class="cabecalho-secao">
          <div class="topo"><p class="rotulo">{c.rotuloRuptura}</p></div>
          <h2>{c.tituloGuerra}</h2>
        </div>
        <div class="corpo">
          {c.guerraP.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="arte">
        <Image src={guerra} alt={c.tituloGuerra} widths={[520, 900]} sizes="(max-width: 900px) 92vw, 46vw" loading="lazy" />
        <span class="cantos" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <section class="citacao">
    <span class="selo-citacao" aria-hidden="true">王</span>
    <span class="halftone" aria-hidden="true"></span>
    <span class="cineticas" aria-hidden="true"></span>
    <figure class="rosto-fundo" aria-hidden="true">
      <Image src={helelRosto} alt="" widths={[460, 900]} sizes="(max-width: 900px) 76vw, 620px" loading="lazy" />
    </figure>

    <div class="envelope fala">
      <blockquote>
        <p>{c.falaHelel}</p>
        <cite>{c.citaHelel}</cite>
      </blockquote>
    </div>
  </section>

  <hr class="regua regua--corte" />

  {/* Vem logo depois da fala de Helel de propósito: ali o leitor acabou de
      conhecer o inimigo da guerra, e a pergunta seguinte é quem a atravessa.
      Era a lacuna da página — antagonista com rosto e voz, e nenhuma
      contraparte.

      Kharzul leva `data-lado="rebeldes"` e portanto o vermelho. O SEGUNDO BLOCO
      NÃO LEVA `data-lado`, e isso é decisão, não esquecimento: a cor carrega
      informação narrativa neste site, e de que lado o rival está é justamente o
      que não se sabe. Pintá-lo de aço afirmaria que é da Hoste. Sem cor, a
      ausência do dado fica visível — que é o efeito desejado. */}
  <section class="secao">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">{c.rotuloDois}</p></div>
        <h2>{c.tituloDois}</h2>
      </div>

      <div class="corpo dois">
        <p class="lead">{c.doisP[0]}</p>
        <div class="par">
          <div class="quem" data-lado="rebeldes"><p>{c.doisP[1]}</p></div>
          <div class="quem quem--sem-nome"><p>{c.doisP[2]}</p></div>
        </div>

        {/* O caminho para os personagens sai DAQUI, e não do fim da página: é
            aqui que a pergunta nasce. O leitor acabou de conhecer dois nomes e
            quer saber quem mais existe — no fim da página ele já passou pelas
            séries e pela mitologia, e a pergunta esfriou.

            Botão, e não link de texto, pela regra firmada em 2026-08-03: ir para
            outra página é botão. Link sem filete não aparece no celular. */}
        <p class="acao-dois">
          <a class="botao botao--fantasma" href={hrefPersonagens}>{rotuloPersonagens}</a>
        </p>
      </div>
    </div>
  </section>

  <!-- "Três séries" desceu para cá em 2026-08-02. A página passou a abrir com o
       MUNDO (os Eternos, os dois lados, as eras, o Poço, a Guerra) e só depois
       dizer em que formatos ele chega. Antes o leitor topava com "cinco
       temporadas e dois longas" antes de saber quem luta contra quem. -->
  <section class="secao">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">{c.rotuloObra}</p></div>
        <h2>{c.tituloSeries}</h2>
      </div>

      <ol class="series">
        {series.map((s) => (
          <li>
            {/* Sem numeral aqui desde 2026-08-03. Ele numerava 01 Saga, 02
                Protogenesis, 03 Desvelar — e a página "A obra" numera as mesmas
                obras em ordem CRONOLÓGICA, onde Protogenesis é 01 e Desvelar é
                08. Duas numerações para as mesmas três coisas, e o leitor que
                passa de uma página para a outra não tem como saber qual vale.
                Aqui o número era decorativo; lá ele diz a ordem da história. */}
            <div class="conteudo">
              <h3>{s.nome}</h3>
              <p class="rotulo">{s.selo}</p>
              <p class="texto">{s.texto}</p>
            </div>
          </li>
        ))}
      </ol>

      <p class="acao-series">
        <a class="botao botao--fantasma" href={hrefObra}>{rotuloObra}</a>
      </p>
    </div>
  </section>

  <hr class="regua" />

  <section class="secao">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">{c.rotuloBase}</p></div>
        <h2>{c.tituloMitologia}</h2>
      </div>
      <div class="corpo">
        {c.mitologiaP.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>


  <section class="secao secao--curta aviso-bloco">
    <div class="envelope">
      <p class="rotulo">{c.rotuloAviso}</p>
      <p class="aviso">{c.aviso}</p>
    </div>
  </section>
</Base>

<style>
  .abertura { position: relative; overflow: hidden; }
  .abertura h1 { font-size: clamp(2rem, 5vw, 4rem); max-width: 20ch; }
  .selo-fundo {
    position: absolute;
    right: -2%; top: -10%;
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(16rem, 34vw, 34rem);
    line-height: 1;
    color: #fff;
    opacity: .025;
    pointer-events: none;
    user-select: none;
  }
  .lead-corpo { font-size: clamp(1.02rem, 1.4vw, 1.2rem); color: var(--cinza); }

  .series { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--linha); border: 1px solid var(--linha); }
  .series li {
    padding: clamp(26px, 3.4vw, 46px);
    background: var(--tinta);
  }
  .series h3 { margin-bottom: 10px; }
  .series .rotulo { margin-bottom: 16px; color: var(--sangue-vivo); }
  .series .texto { color: var(--cinza); max-width: 70ch; margin: 0; }
  .acao-series { margin-top: clamp(20px, 2.4vw, 30px); }

  /* ---------- os dois lados ---------- */
  /* Sem arte, de propósito: não há ilustração para a Hoste e dar uma só aos
     Rebeldes faria parecer que um lado importa mais. O que separa os blocos é
     a COR, que neste projeto já carrega essa informação. */
  .lados {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1px;
    background: var(--linha);
    border: 1px solid var(--linha);
  }
  .lado {
    padding: clamp(26px, 3.2vw, 44px);
    background: var(--tinta);
    border-top: 3px solid var(--lado);
  }
  .lado p { color: var(--cinza); max-width: 58ch; margin: 0; }
  .lados-fecho {
    margin: clamp(22px, 2.6vw, 32px) 0 0;
    max-width: 68ch;
    color: var(--poeira);
  }

  /* ---------- os lugares ---------- */
  /* Quatro blocos, sem arte: não existe ilustração de nenhum dos quatro, e o
     texto do Veilstrand é justamente sobre algo que não se vê.

     Duas colunas em vez de quatro: os verbetes são longos e uma coluna de 4
     apertaria a linha para bem abaixo do confortável. Em duas, a medida fica
     na mesma faixa do resto da página. */
  /* DUAS colunas fixas, e não `auto-fit`. Com auto-fit a 1440px cabiam TRÊS, e
     o quarto lugar caía sozinho na linha de baixo com dois terços de faixa
     vazia ao lado — medido na captura. São quatro itens: 2x2 fecha o retângulo
     em qualquer largura de desktop, e a quantidade não vai mudar. */
  .lugares {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--linha);
    border: 1px solid var(--linha);
  }
  @media (min-width: 760px) {
    .lugares { grid-template-columns: 1fr 1fr; }
  }
  .lugar {
    padding: clamp(26px, 3.2vw, 44px);
    background: var(--tinta);
    border-top: 3px solid var(--lado);
  }
  /* Deserto e Veilstrand não são de lado nenhum. O filete continua existindo,
     em cinza: `--linha-forte` (#2c2c36) sumia contra o fundo e o bloco parecia
     ter perdido a borda, o que lê como defeito e não como informação. Com
     `--poeira` o filete se vê, e o que distingue passa a ser a ausência de COR,
     que é o dado — e não a ausência de filete. */
  .lugar--neutro { border-top-color: var(--poeira); }
  .lugar h3 { margin-bottom: 12px; }
  .lugar p { color: var(--cinza); max-width: 58ch; margin: 0; }

  /* A arte herda de `.arte` o tratamento da página inteira: cinza, contraste
     levemente puxado, cantos cortados na diagonal e a moldura de cantos. É o
     que mantém estas quatro no mesmo mundo visual das artes das Fontes e da
     Guerra, logo abaixo.

     A moldura de cantos vive em `inset: -10px`, ou seja, PARA FORA da imagem.
     Dentro de um card com padding ela encostaria no texto, então aqui ela é
     recolhida para a borda da própria arte. */
  .arte--lugar {
    margin-bottom: clamp(20px, 2.4vw, 28px);
    position: relative;
  }

  /* A COR NO HOVER. Mesma ideia dos retratos em Criadores — repouso em cinza,
     cor para quem se aproxima —, mas aqui não dá para fazer com `filter`: o
     traço destas quatro está GRAVADO no arquivo (equalização local, janela
     tonal estreita, e inversão nas duas cenas claras). Nenhum filtro CSS
     desfaz isso. Então são duas imagens empilhadas, e o que se anima é a
     opacidade da de cima.

     `display: none` fora do media query não é detalhe de estilo: com ele mais
     `loading="lazy"`, o navegador de celular NÃO BAIXA a segunda imagem. Sem
     isso, quem abre no telefone pagaria por uma arte que nunca vai ver, já que
     não há hover ali.

     O PREFIXO `.lugar` NÃO É ENFEITE — é o que faz estas regras existirem.
     Sem ele, `.arte--lugar .cor` pesa 0,2,0 e perde para
     `.lugar .arte--lugar img` (0,2,1), lá embaixo, que aplica `display: block`.
     O `display: none` nunca valeu no celular: as duas artes apareciam
     empilhadas, uma sob a outra, e o telefone ainda baixava a colorida —
     exatamente o contrário do que este bloco existe para fazer. Achado em
     2026-08-04, numa foto do Bruno.

     É a terceira vez que a ordem/especificidade do CSS scoped morde este
     projeto. Não basta ler a regra e achar que ela vale: meça o `display`
     computado a 375px depois de mexer aqui. */
  .lugar .arte--lugar :global(.cor) { display: none; }

  @media (hover: hover) and (pointer: fine) {
    .lugar .arte--lugar :global(.cor) {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      transition: opacity .45s ease;
    }
    .lugar:hover .arte--lugar :global(.cor) { opacity: 1; }
  }

  /* Quem pede menos movimento recebe a troca sem transição, não sem cor. */
  @media (prefers-reduced-motion: reduce) {
    .arte--lugar :global(.cor) { transition: none; }
  }
  /* As quatro são panorâmicas (2000x838). Ficam inteiras, sem corte: a regra do
     projeto vale aqui como em toda parte, e cortar uma paisagem pela metade
     tiraria justamente o que ela tem — a extensão do lugar. */
  /* TESTE 2026-08-03: alto contraste, na pegada das artes de estudo do Bretas.
     Feito por FILTRO e não reprocessando o arquivo — os JPEG continuam
     coloridos no repositório, e voltar atrás é trocar esta linha por
     `filter: none`. */
  .lugar .arte--lugar :global(img) {
    display: block;
    height: auto;
    filter: none;
  }

  /* ---------- os dois que atravessam a Saga ---------- */
  /* Mesmo sistema de "Os dois lados": sem arte, dois blocos, e a cor no topo
     como única distinção. Também não há arte a dar aqui — Kharzul tem, o rival
     não, e ilustrar só um repetiria o desequilíbrio que aquela seção evita.

     A diferença está no segundo bloco. O filete de Kharzul é o vermelho dos
     Rebeldes; o do rival é TRACEJADO e em cinza, porque não se sabe de que lado
     ele está. O tracejado não é enfeite: é a mesma linguagem que o rodapé usa
     para o perfil social que ainda não existe (ver config/site.ts). Lugar
     reservado, marcado como tal, sem fingir um dado que não temos. */
  .acao-dois { margin: clamp(24px, 3vw, 34px) 0 0; }
  .dois .lead { max-width: 68ch; margin: 0 0 clamp(22px, 2.6vw, 32px); }
  .par {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1px;
    background: var(--linha);
    border: 1px solid var(--linha);
  }
  .quem {
    padding: clamp(26px, 3.2vw, 44px);
    background: var(--tinta);
    border-top: 3px solid var(--lado);
  }
  .quem p { color: var(--cinza); max-width: 58ch; margin: 0; }
  .quem--sem-nome {
    border-top-style: dashed;
    border-top-color: var(--linha-forte);
  }

  /* ---------- as eras ---------- */
  /* Fio vertical com um losango por marco: é a mesma marca de seção do site,
     reaproveitada como conta de tempo. Puramente tipográfico, então cresce sem
     pedir arte nova. */
  .eras { list-style: none; margin: 0; padding: 0 0 0 34px; position: relative; }
  .eras::before {
    content: "";
    position: absolute;
    left: 5px; top: 10px; bottom: 10px;
    width: 1px;
    background: linear-gradient(var(--linha-forte), var(--linha));
  }
  .eras li { position: relative; padding-bottom: clamp(26px, 3.4vw, 40px); }
  .eras li:last-child { padding-bottom: 0; }
  .eras li::before {
    content: "";
    position: absolute;
    left: -34px; top: 9px;
    width: 11px; height: 11px;
    background: var(--sangue);
    transform: rotate(45deg);
  }
  .eras h3 { margin-bottom: 8px; }
  .eras p { color: var(--cinza); max-width: 66ch; margin: 0; }

  .duplo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 70px);
    align-items: start;
  }
  .arte { position: relative; }

  /* A arte é bem mais curta que o texto ao lado (402px contra 664 e 892), e com
     align-items:start sobrava 261px e 489px de vazio embaixo dela. Centralizar
     só dividiria a sobra em duas; grudar a arte faz ela acompanhar a leitura,
     então ela está sempre ao lado do parágrafo que está sendo lido.
     Sem z-index de propósito: z-index em ancestral mata o mix-blend-mode das
     artes de traço, e já quebrou duas vezes neste projeto. */
  @media (min-width: 901px) and (min-height: 640px) {
    .duplo .arte {
