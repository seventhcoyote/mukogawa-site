---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import fontes from "../assets/historia/fontes-profanas.jpg";
import guerra from "../assets/historia/guerra-pela-humanidade.jpg";
import helelRosto from "../assets/historia/helel-rosto.png";
import { HISTORIA } from "../i18n/conteudo/historia";
import type { Idioma } from "../i18n/idiomas";

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const c = HISTORIA[idioma];

const series = c.series;
const influencias = c.influencias;
---

<Base titulo={c.titulo} descricao={c.descricao}>
  <section class="secao abertura">
    <span class="selo-fundo" aria-hidden="true">戦</span>
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">{c.rotuloAbertura}</p></div>
        <h1>{c.h1}</h1>
      </div>

      <div class="corpo lead-corpo">
        <p>{c.aberturaP1}</p>
        <p>{c.aberturaP2}</p>
      </div>
    </div>
  </section>


  <section class="secao">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">{c.rotuloObra}</p></div>
        <h2>{c.tituloSeries}</h2>
      </div>

      <ol class="series">
        {series.map((s) => (
          <li>
            <span class="num" aria-hidden="true">{s.num}</span>
            <div class="conteudo">
              <h3>{s.nome}</h3>
              <p class="rotulo">{s.selo}</p>
              <p class="texto">{s.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <hr class="regua regua--corte" />

  <section class="secao">
    <div class="envelope duplo">
      <div class="arte">
        <Image src={fontes} alt={c.tituloPoco} widths={[520, 900]} sizes="(max-width: 900px) 92vw, 46vw" loading="lazy" />
        <span class="cantos" aria-hidden="true"></span>
      </div>
      <div>
        <div class="cabecalho-secao">
          <div class="topo"><p class="rotulo">{c.rotuloPreco}</p></div>
          <h2>{c.tituloPoco}</h2>
        </div>
        <div class="corpo">
          {c.pocoP.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </section>

  <hr class="regua regua--corte" />

  <section class="secao">
    <div class="envelope duplo duplo--invertido">
      <div>
        <div class="cabecalho-secao">
          <div class="topo"><p class="rotulo">{c.rotuloRuptura}</p></div>
          <h2>{c.tituloGuerra}</h2>
        </div>
        <div class="corpo">
          {c.guerraP.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <div class="arte">
        <Image src={guerra} alt={c.tituloGuerra} widths={[520, 900]} sizes="(max-width: 900px) 92vw, 46vw" loading="lazy" />
        <span class="cantos" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <section class="citacao">
    <span class="selo-citacao" aria-hidden="true">王</span>
    <span class="halftone" aria-hidden="true"></span>
    <span class="cineticas" aria-hidden="true"></span>
    <figure class="rosto-fundo" aria-hidden="true">
      <Image src={helelRosto} alt="" widths={[460, 900]} sizes="(max-width: 900px) 76vw, 620px" loading="lazy" />
    </figure>

    <div class="envelope fala">
      <blockquote>
        <p>{c.falaHelel}</p>
        <cite>{c.citaHelel}</cite>
      </blockquote>
    </div>
  </section>

  <section class="secao">
    <div class="envelope duplo duplo--texto">
      <div>
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">{c.rotuloBase}</p></div>
        <h2>{c.tituloMitologia}</h2>
      </div>
      <div class="corpo">
        {c.mitologiaP.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <div class="coluna-lado">

        <div class="cabecalho-secao">
          <div class="topo"><p class="rotulo">{c.rotuloInfluencias}</p></div>
          <h2>{c.tituloInfluencias}</h2>
          <p class="lead">{c.leadInfluencias}</p>
        </div>

        <ul class="influencias">
          {influencias.map((f) => (
            <li>
              <span class="obra">{f.obra}</span>
              <span class="autor">{f.autor}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>


  <section class="secao secao--curta aviso-bloco">
    <div class="envelope">
      <p class="rotulo">{c.rotuloAviso}</p>
      <p class="aviso">{c.aviso}</p>
    </div>
  </section>
</Base>

<style>
  .abertura { position: relative; overflow: hidden; }
  .abertura h1 { font-size: clamp(2rem, 5vw, 4rem); max-width: 20ch; }
  .selo-fundo {
    position: absolute;
    right: -2%; top: -10%;
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(16rem, 34vw, 34rem);
    line-height: 1;
    color: #fff;
    opacity: .025;
    pointer-events: none;
    user-select: none;
  }
  .lead-corpo { font-size: clamp(1.02rem, 1.4vw, 1.2rem); color: var(--cinza); }

  .series { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--linha); border: 1px solid var(--linha); }
  .series li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(20px, 3vw, 46px);
    padding: clamp(26px, 3.4vw, 46px);
    background: var(--tinta);
  }
  .series .num {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1;
    color: #63636f;   /* 3,1:1 no fundo novo: numeral discreto, mas legível */
  }
  .series h3 { margin-bottom: 10px; }
  .series .rotulo { margin-bottom: 16px; color: var(--sangue-vivo); }
  .series .texto { color: var(--cinza); max-width: 70ch; margin: 0; }

  .duplo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 70px);
    align-items: start;
  }
  .arte { position: relative; }

  /* A arte é bem mais curta que o texto ao lado (402px contra 664 e 892), e com
     align-items:start sobrava 261px e 489px de vazio embaixo dela. Centralizar
     só dividiria a sobra em duas; grudar a arte faz ela acompanhar a leitura,
     então ela está sempre ao lado do parágrafo que está sendo lido.
     Sem z-index de propósito: z-index em ancestral mata o mix-blend-mode das
     artes de traço, e já quebrou duas vezes neste projeto. */
  @media (min-width: 901px) and (min-height: 640px) {
    .duplo .arte {
      position: sticky;
      top: calc(76px + clamp(24px, 5vh, 56px));
      align-self: start;
    }
  }
  .arte :global(img) {
    width: 100%;
    filter: grayscale(1) contrast(1.06);
    clip-path: polygon(20px 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%, 0 20px);
  }
  /* arte de traço branco: fundo some e a figura flutua */
  .arte--traco :global(img) {
    mix-blend-mode: screen;
    filter: none;
    clip-path: none;
  }
  .arte--traco .cantos { inset: -14px; }
  .arte .cantos {
    position: absolute; inset: -10px;
    pointer-events: none;
    background:
      linear-gradient(var(--sangue), var(--sangue)) 0 0 / 1px 40px no-repeat,
      linear-gradient(var(--sangue), var(--sangue)) 0 0 / 40px 1px no-repeat,
      linear-gradient(var(--sangue), var(--sangue)) 100% 100% / 1px 40px no-repeat,
      linear-gradient(var(--sangue), var(--sangue)) 100% 100% / 40px 1px no-repeat;
  }

  /* as linhas irradiam do rosto do Helel, não do centro geométrico do bloco */
  .citacao .cineticas { color: var(--sangue); --foco: 68% 46%; opacity: .32; }

  .citacao {
    position: relative;
    overflow: hidden;
    display: grid;
    align-items: center;
    min-height: clamp(360px, 42vw, 520px);
    padding-block: clamp(56px, 9vw, 120px);
    background: var(--tinta-2);
    border-block: 1px solid var(--linha);
  }
  /* O rosto do Helel é FUNDO: entra por trás do texto, com as bordas já
     dissolvidas no próprio PNG, então não existe aresta nem sensação de
     imagem colada. */
  /* dimensionado pela ALTURA da seção: o rosto entra inteiro, sem ser
     decepado pelo overflow. */
  .rosto-fundo {
    position: absolute;
    right: -2%;
    top: 50%;
    transform: translateY(-50%);
    height: 168%;   /* estava 128%: o rosto aparecia de leve demais */
    margin: 0;
    z-index: 0;
    pointer-events: none;
  }
  /* O blend precisa morar AQUI, não na img. `.rosto-fundo` tem
     transform: translateY(-50%) e z-index, o que cria contexto de empilhamento:
     a img lá dentro misturava com o vazio do próprio contêiner, e não com a
     seção. O efeito visível vinha só do opacity. Um elemento com blend E
     transform mistura com o backdrop do PAI — o transform dele só afeta os
     filhos — então mover uma linha resolve. Achado de 2026-08-01; o defeito
     existia desde a rev 6, quando o rosto foi introduzido. */
  .rosto-fundo { mix-blend-mode: screen; }
  .rosto-fundo :global(img) {
    width: auto;
    height: 100%;
    max-width: none;
    opacity: .68;
  }
  .fala { position: relative; }

  @media (max-width: 900px) {
    .rosto-fundo { height: 104%; right: -14%; }
    /* O blend precisa morar AQUI, não na img. `.rosto-fundo` tem
     transform: translateY(-50%) e z-index, o que cria contexto de empilhamento:
     a img lá dentro misturava com o vazio do próprio contêiner, e não com a
     seção. O efeito visível vinha só do opacity. Um elemento com blend E
     transform mistura com o backdrop do PAI — o transform dele só afeta os
     filhos — então mover uma linha resolve. Achado de 2026-08-01; o defeito
     existia desde a rev 6, quando o rosto foi introduzido. */
  .rosto-fundo { mix-blend-mode: screen; }
  .rosto-fundo :global(img) { opacity: .38; }
  }

  /* O vermelho fica do lado do TEXTO. Atrás da arte o fundo é chapado, senão
     o gradiente cria a ilusão de um retângulo em volta da figura. */
  .citacao { background:
      radial-gradient(ellipse 46% 120% at 8% 50%, color-mix(in srgb, var(--sangue) 34%, transparent), transparent 70%),
      var(--tinta-2); }
  .citacao .halftone { color: var(--sangue); opacity: .1; }
  .selo-citacao {
    position: absolute;
    z-index: 0;
    left: 30%; top: 50%;
    transform: translateY(-50%);
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(13rem, 30vw, 30rem);
    line-height: 1;
    color: #fff;
    opacity: .05;
    pointer-events: none;
    user-select: none;
  }
  /* Sem z-index aqui: ele criava contexto de empilhamento e o mix-blend-mode
     da arte deixava de compor com o fundo da seção. */
  .citacao .envelope { position: relative; }
  /* Medida em px, não em ch: o `ch` resolveria na fonte do blockquote
     (Barlow 17px) e não na Cinzel gigante do parágrafo, espremendo a frase. */
  blockquote { margin: 0; }
  blockquote p {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 3.6vw, 2.9rem);
    line-height: 1.16;
    text-wrap: balance;
    color: var(--osso);
    margin-bottom: 22px;
  }
  cite {
    font-family: var(--fonte-ui);
    font-style: normal;
    font-weight: 600;
    font-size: .84rem;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: var(--sangue-vivo);
  }

  .duplo--texto { align-items: start; }
  .influencias { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; background: var(--linha); border: 1px solid var(--linha); }
  .influencias li { display: grid; gap: 6px; padding: 22px 24px; background: var(--tinta); }
  .influencias .obra { font-family: var(--fonte-display); font-weight: 700; font-size: 1.4rem; color: var(--osso); }
  .influencias .autor { font-family: var(--fonte-ui); font-size: .84rem; letter-spacing: .2em; text-transform: uppercase; color: var(--poeira); }

  .aviso-bloco { border-top: 1px solid var(--linha); }
  .aviso { max-width: 74ch; color: var(--poeira); margin-top: 14px; }

  @media (max-width: 900px) {
    .duplo { grid-template-columns: 1fr; }
    .duplo--invertido .arte { order: -1; }
    .series li { grid-template-columns: 1fr; gap: 10px; }
  }
</style>
