---
/**
 * Início.
 *
 * ENCOLHIDA EM 2026-10-16, na reformulação Bleeding Light: a home deixou de
 * apresentar o mundo e virou a porta da campanha. Saíram a faixa com a contagem
 * regressiva, "O que sai primeiro", "Três formas, uma narrativa", "A história",
 * "Personagens" e "As Nove Classes" — as quatro últimas porque as páginas que
 * elas alimentavam saíram do site.
 *
 * Ficaram três blocos: o hero, a leitura dramatizada e a newsletter. O conteúdo
 * removido não se perdeu: está na tag `v5-antes-bleeding-light`.
 */
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import GostoDaNarrativa from "../components/GostoDaNarrativa.astro";
import ListaEspera from "../components/ListaEspera.astro";
import { INICIO } from "../i18n/conteudo/inicio";
import type { Idioma } from "../i18n/idiomas";

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const c = INICIO[idioma];
---

<Base titulo="Mukō-Gawa" descricao={c.heroLead} colado>
  <Hero />
  <GostoDaNarrativa />
  <ListaEspera comCapa={false} />
</Base>
