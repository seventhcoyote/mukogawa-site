---
import Revelar from "../components/Revelar.astro";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import manga from "../assets/formatos/manga.jpg";
import livros from "../assets/formatos/livros.jpg";
import anime from "../assets/formatos/anime.jpg";
import guerra from "../assets/historia/guerra-pela-humanidade.jpg";
import Hero from "../components/Hero.astro";
import Anuncio from "../components/Anuncio.astro";
import GostoDaNarrativa from "../components/GostoDaNarrativa.astro";
import GradePersonagens from "../components/GradePersonagens.astro";
import ListaEspera from "../components/ListaEspera.astro";
import { INICIO } from "../i18n/conteudo/inicio";
import { personagensDoIdioma, classesDoIdioma, ROTULOS_PERSONAGENS } from "../i18n/conteudo/personagens";
import { rota } from "../i18n/idiomas";
import type { Idioma } from "../i18n/idiomas";

interface Props { idioma: Idioma }
const { idioma } = Astro.props;

const c = INICIO[idioma];
const rot = ROTULOS_PERSONAGENS[idioma];
const personagens = personagensDoIdioma(idioma);
const CLASSES = classesDoIdioma(idioma);
// As artes são estruturais e não mudam por idioma; só o texto muda.
const artesFormato = [manga, livros, anime];
const formatos = c.formatos.map((f, i) => ({ ...f, img: artesFormato[i] }));
const hrefHistoria = rota("historia", idioma);
const hrefPersonagens = rota("personagens", idioma);
---

<Base titulo="Mukō-Gawa" descricao={c.descricao}
  colado
>
  <Hero />
  <Anuncio />

  <GostoDaNarrativa />

  <!-- ================= três formas ================= -->
  <section class="secao">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">{c.narrativaRotulo}</p></div>
        <h2>{c.narrativaTitulo}</h2>
      </div>

      <Revelar><div class="formatos">
        {formatos.map((f) => (
          <article class:list={["formato", { "formato--destaque": f.destaque }]}>
            <div class="moldura">
              <Image
                src={f.img}
                alt={f.titulo}
                widths={[420, 780]}
                sizes="(max-width: 820px) 92vw, 32vw"
                loading="lazy"
              />
              <span class="veu" aria-hidden="true"></span>
            </div>
            <p class="rotulo selo">{f.selo}</p>
            <h3>{f.titulo}</h3>
            <p class="texto">{f.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>


  <!-- ================= a historia ================= -->
  <section class="secao narrativa">
    <div class="envelope duplo">
      <div class="lado-texto">
        <div class="cabecalho-secao">
          <div class="topo"><p class="rotulo">{c.historiaRotulo}</p></div>
          <h2>{c.historiaTitulo}</h2>
        </div>
        <p class="lead">{c.historiaLead}</p>
        <p class="acao"><a class="link-varre" href={hrefHistoria}>{c.historiaCta}</a></p>
      </div>

      <div class="lado-arte">
        <Image
          src={guerra}
          alt={c.historiaTitulo}
          widths={[520, 900]}
          sizes="(max-width: 900px) 92vw, 46vw"
          loading="lazy"
        />
        <span class="cantos" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <hr class="regua" />

  <!-- ================= personagens ================= -->
  <section class="secao">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo">
          <p class="rotulo">{c.elencoRotulo}</p>
        </div>
        <div class="linha-titulo">
          <h2>{c.elencoTitulo}</h2>
          <a class="link-varre" href={hrefPersonagens}>{c.elencoTodos}</a>
        </div>
      </div>

      <Revelar forca="fade"><GradePersonagens lista={personagens} /></Revelar>
    </div>
  </section>

  <hr class="regua" />

  <!-- ================= as nove classes ================= -->
  <section class="secao classes">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">{c.classesRotulo}</p></div>
        <h2>{c.classesTitulo}</h2>
        <p class="lead">{c.classesLead}</p>
      </div>

      {/* As nove sempre estiveram numeradas de 01 a 09, e essa numeração JÁ era
          a hierarquia dos Escalões — do mais baixo ao mais alto, três a três.
          A lista plana escondia isso, e a ordem parecia arbitrária. Agrupar não
          acrescenta informação nova: revela a que já estava ali. */}
      {c.escaloes.map((esc, i) => (
        <div class="escalao">
          <div class="escalao-topo">
            <h3>{esc.nome}</h3>
            {esc.nota && <p class="escalao-nota">{esc.nota}</p>}
          </div>

          <div class="lista-classes">
            {CLASSES.slice(i * 3, i * 3 + 3).map((cl) => (
              <details name="classe">
                <summary>
                  <span class="kanji" aria-hidden="true">{cl.kanji}</span>
                  <span class="num">{cl.num}</span>
                  <span class="nome">{cl.nome}</span>
                  <span class="sinal" aria-hidden="true"></span>
                </summary>
                <div class="descricao"><p>{cl.descricao}</p></div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <ListaEspera />
</Base>

<style>
  /* ---------- três formas ---------- */
  /* O gap precisa ser declarado nos dois eixos separadamente. Um `gap` único
     valia também para as QUATRO linhas do subgrid, e cada espaço interno do
     card levava 37px de gap somado ao próprio margin: moldura→selo saía em
     57px, selo→título em 59px, título→texto em 49px. Entre as colunas o
     respiro é bem-vindo; dentro do card ele afastava informação que pertence
     junta. A separação vertical agora é só dos margins, que estão logo abaixo
     e são o ritmo de leitura de fato. */
  .formatos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    grid-template-rows: auto auto auto auto;
    column-gap: clamp(20px, 2.6vw, 38px);
    row-gap: clamp(40px, 4vw, 56px);   /* entre FILEIRAS de cards, ver abaixo */
  }
  /* Os três cards seguem o mesmo ritmo vertical mesmo quando o selo
     quebra em duas linhas, senão os títulos desalinham. */
  /* Subgrid: os três cards compartilham as MESMAS linhas, então moldura, selo,
     título e texto ficam alinhados mesmo quando um selo ocupa duas linhas e os
     outros só uma — que era o caso de "Em desenvolvimento // Ainda sem
     produção" e empurrava o título do Anime 12px para baixo. Vale em qualquer
     idioma, sem depender de min-height chutado. */
  /* O subgrid herda os gaps do pai por padrão, mas pode declarar os seus — e é
     disso que este layout precisa, porque as mesmas linhas servem a dois papéis
     opostos: separar um card do outro quando eles empilham, e separar moldura,
     selo, título e texto DENTRO do card. O pai cuida do primeiro (row-gap
     grande, só entre fileiras); o card zera o seu e deixa o ritmo interno com
     os margins. Sem esta linha, em uma e em duas colunas os cards encostavam
     um no outro — medido em 0px. */
  .formato {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 4;
    align-content: start;
    row-gap: 0;
  }
  /* O ritmo vertical do card, agora sem gap somando por baixo. Selo e título
     são a mesma unidade de informação — quem lê "Primeiro volume // dezembro
     de 2026" está lendo a legenda de "Mangá" — então ficam próximos, e o
     respiro maior fica entre a arte e o texto. */
  /* A linha do título sobra ~13px além do texto: são as métricas da Zen Old
     Mincho, que reserva caixa de linha de fonte CJK. Margin não tira essa
     folga — só decide de que lado ela cai. `center` divide, para o título não
     ficar nem colado no selo nem solto do texto. */
  .formato h3 { margin: 0 0 10px; align-self: center; }
  .formato .selo {
    margin: 0 0 8px;
    display: flex;
    align-items: flex-start;
  }
  .formato .texto { margin: 0; }

  /* Navegador sem subgrid: volta ao empilhamento simples, com um piso de duas
     linhas no selo para o desalinhamento ficar pequeno em vez de gritante. */
  @supports not (grid-template-rows: subgrid) {
    .formato { display: flex; flex-direction: column; }
    .formato .selo { min-height: 3.6em; }
  }
  .formato .texto { color: var(--cinza); font-size: .98rem; }
  .formato--destaque .selo { color: var(--sangue-vivo); }

  .moldura {
    position: relative;
    background: var(--vazio);
    isolation: isolate;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-bottom: 18px;
    border: 1px solid var(--linha);
    clip-path: polygon(16px 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%, 0 16px);
  }
  /* As artes já vêm encaixadas inteiras numa moldura 4:3 de fundo preto,
     então "cover" não corta nada. O blend faz o fundo sumir. */
  .moldura :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    mix-blend-mode: screen;
    transition: transform .6s cubic-bezier(.16,.84,.28,1);
  }
  .moldura .veu {
    position: absolute; inset: 0;
    background: linear-gradient(0deg, color-mix(in srgb, var(--tinta) 88%, transparent), transparent 58%);
  }
  .formato:hover .moldura :global(img) { transform: scale(1.04); }
  .formato--destaque .moldura { border-color: color-mix(in srgb, var(--sangue) 55%, transparent); }

  /* ---------- narrativa ---------- */
  .duplo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 76px);
    align-items: center;
  }
  .narrativa h2 { font-size: clamp(1.7rem, 3vw, 2.9rem); }
  .acao { margin-top: 26px; }

  .lado-arte { position: relative; }
  .lado-arte :global(img) {
    width: 100%;
    filter: grayscale(1) contrast(1.06);
    clip-path: polygon(20px 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%, 0 20px);
  }
  .lado-arte .cantos {
    position: absolute; inset: -10px;
    pointer-events: none;
    background:
      linear-gradient(var(--sangue), var(--sangue)) 0 0 / 1px 40px no-repeat,
      linear-gradient(var(--sangue), var(--sangue)) 0 0 / 40px 1px no-repeat,
      linear-gradient(var(--sangue), var(--sangue)) 100% 100% / 1px 40px no-repeat,
      linear-gradient(var(--sangue), var(--sangue)) 100% 100% / 40px 1px no-repeat;
  }

  .linha-titulo {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  /* ---------- classes ---------- */
  /* 3x3 fixo: nove itens sempre fecham a grade, nenhum bloco fica maior. */
  /* ---------- as nove classes ----------
     Eram nove células de grade que só diziam o nome. A descrição de cada classe
     já existia, mas só aparecia dentro da página de um personagem, em "A ordem"
     — informação enterrada atrás de dois cliques e de saber que ela estava lá.

     Agora cada classe abre. É `<details name="classe">`: acordeão nativo, um
     aberto por vez, sem uma linha de JavaScript. O teclado funciona sozinho, o
     leitor de tela anuncia o estado, e quem chega com JS desligado vê tudo
     igual. Virou lista em vez de grade porque o texto tem 500 a 800 caracteres:
     numa célula de um terço da largura ele viraria uma coluna estreita e alta,
     e ao abrir empurraria as outras duas células da fileira. */
  /* ---------- escalões ---------- */
  .escalao + .escalao { margin-top: clamp(30px, 3.6vw, 52px); }
  .escalao-topo {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px clamp(16px, 2vw, 28px);
    margin-bottom: clamp(12px, 1.4vw, 18px);
  }
  .escalao-topo h3 {
    margin: 0;
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    white-space: nowrap;
  }
  /* Só o Primeiro Escalão tem nota, porque só dele existe informação do autor.
     Inventar caracterização para os outros dois seria preencher buraco com
     invenção, e este site não faz isso. */
  .escalao-nota {
    margin: 0;
    flex: 1 1 22ch;
    max-width: 74ch;
    font-size: .95rem;
    color: var(--poeira);
  }

  .lista-classes {
    display: grid;
    gap: 1px;
    background: var(--linha);
    border: 1px solid var(--linha);
  }

  .lista-classes details {
    position: relative;
    background: var(--tinta);
    overflow: hidden;
    transition: background .3s ease;
  }
  .lista-classes details[open] { background: var(--tinta-2); }

  .lista-classes summary {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 26px);
    min-height: 64px;              /* alvo de toque com folga */
    padding: 16px clamp(48px, 6vw, 62px) 16px clamp(16px, 2.4vw, 26px);
    cursor: pointer;
    list-style: none;              /* fora o triângulo padrão */
    transition: background .3s ease;
  }
  .lista-classes summary::-webkit-details-marker { display: none; }
  .lista-classes summary:hover { background: var(--tinta-2); }
  .lista-classes summary:focus-visible {
    outline: 2px solid var(--sangue-vivo);
    outline-offset: -2px;
  }

  /* O kanji continua sendo a marca da classe, agora ancorado à direita e
     atrás do sinal de abrir. */
  .lista-classes .kanji {
    position: absolute;
    right: clamp(40px, 5vw, 58px);
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(3rem, 6vw, 4.6rem);
    line-height: 1;
    color: #fff;
    opacity: .05;
    pointer-events: none;
    transition: opacity .3s ease, transform .4s cubic-bezier(.16,.84,.28,1);
  }
  .lista-classes summary:hover .kanji,
  .lista-classes details[open] .kanji { opacity: .13; }
  .lista-classes details[open] .kanji { transform: translateY(-50%) scale(1.04); }

  .lista-classes .num {
    flex: none;
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: .72rem;
    letter-spacing: .3em;
    color: var(--sangue-vivo);
  }
  .lista-classes .nome {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    color: var(--osso);
  }

  /* Cruz que vira menos: diz "abre" sem depender de texto e sem traduzir. */
  .lista-classes .sinal {
    position: absolute;
    right: clamp(16px, 2.4vw, 26px);
    top: 50%;
    width: 13px;
    height: 13px;
    transform: translateY(-50%);
    flex: none;
  }
  .lista-classes .sinal::before,
  .lista-classes .sinal::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background: var(--cinza);
    transition: transform .35s cubic-bezier(.16,.84,.28,1), background .3s ease;
  }
  .lista-classes .sinal::after { transform: rotate(90deg); }
  .lista-classes details[open] .sinal::after { transform: rotate(0deg); }
  .lista-classes summary:hover .sinal::before,
  .lista-classes summary:hover .sinal::after,
  .lista-classes details[open] .sinal::before,
  .lista-classes details[open] .sinal::after { background: var(--sangue-vivo); }

  .lista-classes .descricao {
    padding: 0 clamp(16px, 2.4vw, 26px) 26px;
    max-width: 74ch;
  }
  .lista-classes .descricao p {
    margin: 0;
    color: var(--cinza);
    font-size: .98rem;
  }

  /* A abertura desliza; quem pede menos movimento recebe o corte seco. */
  @media (prefers-reduced-motion: no-preference) {
    .lista-classes details[open] .descricao { animation: classe-abre .34s ease both; }
    @keyframes classe-abre {
      from { opacity: 0; transform: translateY(-6px); }
      to   { opacity: 1; transform: none; }
    }
  }

  @media (max-width: 900px) {
    .duplo { grid-template-columns: 1fr; }
    .lado-arte { order: -1; }
  }
</style>
