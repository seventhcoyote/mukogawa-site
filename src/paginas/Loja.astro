---
import Base from "../layouts/Base.astro";
import CapaVolume from "../components/CapaVolume.astro";
import ListaEspera from "../components/ListaEspera.astro";
import { LOJA } from "../i18n/conteudo/loja";
import { rota } from "../i18n/idiomas";
import type { Idioma } from "../i18n/idiomas";

interface Props { idioma: Idioma }
const { idioma } = Astro.props;

const c = LOJA[idioma];
const regioes = c.regioes;
const hrefEspera = `${rota("inicio", idioma).replace(/\/$/, "")}/#lista-de-espera`;
const hrefFaq = rota("faq", idioma);
---

<Base titulo={c.titulo} descricao={c.descricao}>
  <section class="secao secao--curta">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">{c.rotulo}</p></div>
        <h1>{c.titulo}</h1>
        <p class="lead">{c.lead}</p>
      </div>

      <div class="vitrine">
        <div class="coluna-capa">
          <CapaVolume alt={c.capaAlt} giro={-1.4} />
        </div>

        <div class="coluna-compra">
          <div class="sobre-capa">
            <p class="rotulo rotulo--lado" data-lado="rebeldes">{c.capaRotulo}</p>
            <h2>{c.capaTitulo}</h2>
            <p class="texto-capa">{c.capaTexto}</p>
          </div>

          <ul class="regioes">
            {regioes.map((r) => (
              <li class:list={["regiao", { "regiao--destaque": r.destaque }]}>
                <div class="topo-cartao">
                  <span class="codigo">{r.codigo}</span>
                  <div>
                    <p class="pais">{r.pais}</p>
                    <p class="canal">{r.canal}</p>
                  </div>
                  <p class="quando">{r.quando}</p>
                </div>

                <p class="texto">{r.texto}</p>

                <div class="baixo-cartao">
                  <p class="estado">
                    <span class="ponto" aria-hidden="true"></span>
                    {c.semLink}
                  </p>
                  <a class="botao botao--fantasma" href="#lista-de-espera">{c.aviseMe}</a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <p class="nota">
        {c.nota}
        <a class="nota-link" href={hrefFaq}>{c.duvidas}</a>.
      </p>
    </div>
  </section>

  <ListaEspera comCapa={false} />
</Base>

<style>
  h1 { font-size: clamp(2.4rem, 6vw, 4.6rem); }

  /* A vitrine tinha capa alta de um lado e um texto curto do outro, e sobrava
     quase meia tela de vazio à direita. Os cartões de região subiram para essa
     coluna: a altura dos três acompanha a da capa, o vazio some e a informação
     de compra fica junto do produto, que é onde ela deve estar. */
  .vitrine {
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    align-items: start;
    gap: clamp(30px, 4.5vw, 66px);
    margin-bottom: clamp(36px, 5vw, 64px);
  }

  .coluna-capa { position: sticky; top: calc(76px + 28px); }

  .sobre-capa h2 { margin: 14px 0 14px; font-size: clamp(1.7rem, 2.8vw, 2.5rem); }
  .texto-capa { color: var(--cinza); max-width: 54ch; margin: 0 0 clamp(26px, 3.4vw, 40px); }

  .regioes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--linha);
    border: 1px solid var(--linha);
  }

  .regiao {
    display: grid;
    gap: 12px;
    padding: clamp(20px, 2.4vw, 28px);
    background: var(--tinta-2);
  }
  .regiao--destaque { box-shadow: inset 3px 0 0 var(--sangue); }

  .topo-cartao {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .codigo {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: 1.7rem;
    line-height: 1;
    color: var(--osso);
  }
  .pais {
    margin: 0;
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: .9rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--osso);
  }
  .canal {
    margin: 2px 0 0;
    font-family: var(--fonte-ui);
    font-size: .74rem;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--poeira);
  }
  .quando {
    margin: 0 0 0 auto;
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: .74rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--sangue-vivo);
  }

  .texto { margin: 0; color: var(--cinza); font-size: .94rem; max-width: 62ch; }

  .baixo-cartao {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--linha);
  }
  .estado {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-family: var(--fonte-ui);
    font-size: .76rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--poeira);
  }
  .estado .ponto { width: 7px; height: 7px; flex: none; background: var(--poeira); }
  .baixo-cartao .botao { min-height: 44px; padding-inline: 22px; font-size: .82rem; }

  .nota {
    margin: 0;
    max-width: 72ch;
    color: var(--poeira);
    font-size: .92rem;
  }
  .nota-link {
    color: var(--osso);
    text-decoration: underline;
    text-decoration-color: var(--linha-forte);
    text-underline-offset: 4px;
    transition: text-decoration-color .18s ease;
  }
  .nota-link:hover { text-decoration-color: var(--sangue-vivo); }

  @media (max-width: 980px) {
    .vitrine { grid-template-columns: 1fr; gap: clamp(26px, 5vw, 40px); }
    .coluna-capa { position: static; max-width: 300px; margin-inline: auto; }
  }

  @media (max-width: 560px) {
    .quando { margin-left: 0; width: 100%; }
    .baixo-cartao .botao { width: 100%; }
  }
</style>
