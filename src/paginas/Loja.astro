---
/**
 * Loja.
 *
 * REFEITA EM 2026-10-16. Saíram a vitrine do yomikiri e os três cartões de
 * região, que diziam "link de venda ainda não disponível" — o lançamento passou
 * a ser comunicado como Bleeding Light e a venda acontece na campanha.
 *
 * PT mostra campanha + apostila + newsletter. EN e JA mostram só um aviso: a
 * Orvalho envia dentro do Brasil e a campanha é em português, então uma loja
 * ali seria uma vitrine que ninguém pode usar. Em vez de página vazia, um
 * caminho para o Bleeding Light do próprio idioma.
 */
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import ListaEspera from "../components/ListaEspera.astro";
import { LOJA } from "../i18n/conteudo/loja";
import { VENDAS } from "../config/site";
import { usarUI } from "../i18n/ui";
import { rota } from "../i18n/idiomas";
import type { Idioma } from "../i18n/idiomas";
import apostila from "../assets/loja/kit-apostila.jpg";
import capaCampanha from "../assets/mukogawa/bl-campanha-capa.jpg";

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const c = LOJA[idioma];
const t = usarUI(idioma);
const ehPt = idioma === "pt";
const hrefBleeding = rota("bleedingLight", idioma);
---

{ehPt ? (
  <Base titulo={c.catarse.h1} descricao={c.catarse.lede}>
    <section class="secao secao--curta">
      <div class="envelope">
        <div class="cabecalho-secao">
          <div class="topo"><p class="rotulo">{c.rotulo}</p></div>
          <h1>{c.catarse.h1}</h1>
        </div>

        {/* A campanha vem antes da apostila: é o lançamento, e a apostila é
            material de bastidor. */}
        <section class="campanha">
          <div class="peca">
            <Image src={capaCampanha} alt={c.catarse.alt} widths={[420, 700, 1200]}
                   sizes="(max-width: 860px) 92vw, 46vw" loading="eager" />
          </div>
          <div class="sobre">
            <p class="rotulo rotulo--lado" data-lado="rebeldes">{c.catarse.rotulo}</p>
            <h2>{c.catarse.titulo}</h2>
            <p class="texto">{c.catarse.lede}</p>
            <p class="texto">{c.catarse.texto}</p>
            <a class="botao" href={VENDAS.catarse} target="_blank" rel="noopener noreferrer">
              {t("catarse.seguir")}
            </a>
            <p class="abertura">{c.catarse.abertura}</p>
          </div>
        </section>

        <hr class="regua regua--corte" />

        <section class="disponivel" aria-labelledby="titulo-disponivel">
          <div class="peca">
            <Image src={apostila} alt={c.disponivel.alt} widths={[420, 700, 1000]}
                   sizes="(max-width: 860px) 320px, 38vw" loading="lazy" />
          </div>
          <div class="sobre">
            <p class="rotulo rotulo--lado" data-lado="rebeldes">{c.disponivel.rotulo}</p>
            <h2 id="titulo-disponivel">{c.disponivel.titulo}</h2>
            <p class="texto">{c.disponivel.texto}</p>
            <ul class="ficha">{c.disponivel.ficha.map((i) => (<li>{i}</li>))}</ul>
            <a class="botao" href={VENDAS.apostila} target="_blank" rel="noopener noreferrer">
              {c.disponivel.cta}
            </a>
            <p class="abertura">{c.disponivel.nota}</p>
          </div>
        </section>
      </div>
    </section>

    <ListaEspera comCapa={false} />
  </Base>
) : (
  <Base titulo={c.emBreve.titulo} descricao={c.emBreve.texto}>
    <section class="secao secao--curta">
      <div class="envelope aviso">
        <p class="rotulo rotulo--lado" data-lado="rebeldes">{c.emBreve.rotulo}</p>
        <h1>{c.emBreve.titulo}</h1>
        <p class="texto-aviso">{c.emBreve.texto}</p>
        <a class="botao botao--fantasma" href={hrefBleeding}>{c.emBreve.cta}</a>
      </div>
    </section>
  </Base>
)}

<style>
  h1 { font-size: clamp(2.4rem, 6vw, 4.6rem); }

  .campanha, .disponivel {
    display: grid;
    grid-template-columns: minmax(0, 460px) minmax(0, 1fr);
    align-items: center;
    gap: clamp(28px, 4.5vw, 60px);
    margin-bottom: clamp(34px, 5vw, 56px);
  }
  .disponivel { grid-template-columns: minmax(0, 420px) minmax(0, 1fr); }

  /* Fotografia e capa sobre fundo preto: sombra funda e fio de luz no topo,
     para lerem como objeto apoiado e não como retângulo colado. */
  .peca { position: relative; line-height: 0; }
  .peca :global(img) {
    display: block;
    width: 100%;
    height: auto;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, .06),
      0 30px 52px -26px rgba(0, 0, 0, 1),
      0 0 80px -30px color-mix(in srgb, var(--sangue) 60%, transparent);
  }

  .sobre h2 { margin: 18px 0 16px; font-size: clamp(1.7rem, 2.6vw, 2.3rem); }
  .texto { color: var(--cinza); max-width: 46ch; margin: 0 0 16px; }
  .sobre .botao { margin-top: 10px; }
  .abertura {
    margin: 18px 0 0;
    font-size: .88rem;
    color: var(--poeira);
    max-width: 46ch;
  }

  .ficha {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 14px;
    margin: 0 0 24px;
    padding: 0;
    font-family: var(--fonte-ui);
    font-size: .74rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--poeira);
  }
  .ficha li { display: flex; align-items: center; gap: 14px; }
  .ficha li::before { content: ""; width: 1px; height: 11px; background: var(--linha-forte); }
  .ficha li:first-child::before { display: none; }
  .ficha li:nth-child(2) { color: var(--sangue-vivo); }

  /* EN/JA: um bloco só, centrado, sem vitrine nenhuma. */
  .aviso { max-width: 56ch; }
  .texto-aviso { color: var(--cinza); margin: 16px 0 30px; }

  @media (max-width: 860px) {
    .campanha, .disponivel { display: block; }
    .disponivel .peca { max-width: 320px; }
    .sobre { margin-top: clamp(24px, 5vw, 34px); }
  }
  @media (max-width: 620px) {
    .ficha { display: grid; gap: 7px; }
    .ficha li::before { display: none; }
    .sobre .botao, .aviso .botao { width: 100%; }
  }
</style>
