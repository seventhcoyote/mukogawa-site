---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import capa from "../assets/loja/capa-volume-1.jpg";
import ListaEspera from "../components/ListaEspera.astro";
import { LOJA } from "../i18n/conteudo/loja";
import { rota } from "../i18n/idiomas";
import type { Idioma } from "../i18n/idiomas";

interface Props { idioma: Idioma }
const { idioma } = Astro.props;

const c = LOJA[idioma];
const regioes = c.regioes;
const hrefEspera = `${rota("inicio", idioma).replace(/\/$/, "")}/#lista-de-espera`;
const hrefFaq = rota("faq", idioma);
---

<Base titulo={c.titulo} descricao={c.descricao}>
  <section class="secao secao--curta">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">{c.rotulo}</p></div>
        <h1>{c.titulo}</h1>
        <p class="lead">{c.lead}</p>
      </div>

      <div class="vitrine">
        <figure class="capa">
          <Image src={capa} alt={c.capaAlt} widths={[520, 900, 1400]}
                 sizes="(max-width: 900px) 78vw, 40vw" loading="eager" />
        </figure>
        <div class="sobre-capa">
          <p class="rotulo rotulo--lado" data-lado="rebeldes">{c.capaRotulo}</p>
          <h2>{c.capaTitulo}</h2>
          <p class="texto-capa">{c.capaTexto}</p>
        </div>
      </div>

      <ul class="regioes">
        {regioes.map((r) => (
          <li class:list={["regiao", { "regiao--destaque": r.destaque }]}>
            <div class="topo-cartao">
              <span class="codigo">{r.codigo}</span>
              <div>
                <p class="pais">{r.pais}</p>
                <p class="canal">{r.canal}</p>
              </div>
            </div>

            <p class="texto">{r.texto}</p>

            <p class="quando">{r.quando}</p>

            <p class="estado">
              <span class="ponto" aria-hidden="true"></span>
              {c.semLink}
            </p>

            <a class="botao botao--fantasma" href="#lista-de-espera">{c.aviseMe}</a>
          </li>
        ))}
      </ul>

      <p class="nota">
        {c.nota}
        <a class="nota-link" href={hrefFaq}>{c.duvidas}</a>.
      </p>
    </div>
  </section>

  <ListaEspera comCapa={false} />
</Base>

<style>
  /* A capa tem moldura branca própria e crédito impresso: é uma peça acabada,
     não uma imagem para sangrar no fundo. Num site preto, colar isso viraria o
     retângulo que este projeto recusa. Tratada como objeto físico — lombada,
     sombra e um leve giro — a borda branca vira papel e passa a fazer sentido. */
  .vitrine {
    display: grid;
    grid-template-columns: minmax(0, 42%) minmax(0, 1fr);
    align-items: center;
    gap: clamp(28px, 5vw, 72px);
    margin-bottom: clamp(48px, 7vw, 96px);
  }

  .capa {
    position: relative;
    margin: 0;
    transform: rotate(-1.4deg);
    transition: transform .5s cubic-bezier(.2, .8, .2, 1);
  }
  .capa :global(img) {
    display: block;
    width: 100%;
    height: auto;
    box-shadow:
      0 2px 0 rgba(255, 255, 255, .06),
      -10px 0 22px -12px rgba(0, 0, 0, .9),
      0 34px 60px -28px rgba(0, 0, 0, 1),
      0 0 90px -30px color-mix(in srgb, var(--sangue) 60%, transparent);
  }
  /* lombada: a espessura do volume, do lado esquerdo */
  .capa::before {
    content: "";
    position: absolute;
    inset: 2% auto 2% -9px;
    width: 9px;
    background: linear-gradient(90deg, #16161a, #2a2a31 55%, #0a0a0c);
    box-shadow: inset -1px 0 0 rgba(0, 0, 0, .8);
  }
  .capa:hover { transform: rotate(0deg) translateY(-4px); }

  .sobre-capa h2 { margin: 16px 0 18px; font-size: clamp(1.8rem, 3.2vw, 2.9rem); }
  .texto-capa { color: var(--cinza); max-width: 46ch; margin: 0; }

  @media (prefers-reduced-motion: reduce) {
    .capa, .capa:hover { transition: none; transform: rotate(-1.4deg); }
  }

  @media (max-width: 900px) {
    .vitrine { grid-template-columns: 1fr; gap: clamp(24px, 5vw, 40px); }
    .capa { max-width: 320px; margin-inline: auto; }
  }

  h1 { font-size: clamp(2.4rem, 6vw, 4.6rem); }

  .regioes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(18px, 2.4vw, 30px);
  }

  .regiao {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(24px, 3vw, 36px);
    background: var(--tinta-2);
    border: 1px solid var(--linha);
    clip-path: polygon(18px 0, 100% 0, 100% calc(100% - 18px), calc(100% - 18px) 100%, 0 100%, 0 18px);
  }
  .regiao--destaque { border-color: color-mix(in srgb, var(--sangue) 55%, transparent); }

  .topo-cartao { display: flex; align-items: center; gap: 16px; }
  .codigo {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: 2rem;
    line-height: 1;
    color: var(--osso);
  }
  .pais {
    margin: 0;
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: .95rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--osso);
  }
  .canal {
    margin: 2px 0 0;
    font-family: var(--fonte-ui);
    font-size: .78rem;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--poeira);
  }

  .texto { margin: 0; color: var(--cinza); font-size: .96rem; }

  .quando {
    margin: 0;
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: .8rem;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--sangue-vivo);
  }

  .estado {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid var(--linha);
    font-family: var(--fonte-ui);
    font-size: .78rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--poeira);
  }
  .estado .ponto {
    width: 7px; height: 7px; flex: none;
    background: var(--poeira);
  }

  .regiao .botao { margin-top: auto; }

  .nota {
    margin: clamp(28px, 4vw, 44px) 0 0;
    max-width: 62ch;
    color: var(--poeira);
    font-size: .92rem;
  }
  .nota-link {
    color: var(--osso);
    text-decoration: underline;
    text-decoration-color: var(--linha-forte);
    text-underline-offset: 4px;
    transition: text-decoration-color .18s ease;
  }
  .nota-link:hover { text-decoration-color: var(--sangue-vivo); }
</style>
