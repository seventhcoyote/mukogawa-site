---
import Base from "../layouts/Base.astro";
import ListaEspera from "../components/ListaEspera.astro";
import { FAQ } from "../i18n/conteudo/faq";
import type { Idioma } from "../i18n/idiomas";

interface Props { idioma: Idioma }
const { idioma } = Astro.props;

const c = FAQ[idioma];
const grupos = c.grupos;

const semTags = (t: string) => t.replace(/<[^>]+>/g, "");
const dadosEstruturados = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: grupos.flatMap((g) =>
    g.perguntas.map((q) => ({
      "@type": "Question",
      name: q.p,
      acceptedAnswer: { "@type": "Answer", text: q.r.map(semTags).join(" ") },
    })),
  ),
};
---

<Base titulo={c.titulo} descricao={c.descricao}>
  <section class="secao secao--curta abertura">
    <span class="selo-fundo" aria-hidden="true">問</span>
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">{c.rotulo}</p></div>
        <h1>{c.titulo}</h1>
        <p class="lead">{c.lead}</p>
      </div>
    </div>
  </section>

  {grupos.map((g, i) => (
    <>
      {i > 0 && <hr class="regua" />}
      <section class="secao secao--curta">
        <div class="envelope">
          <div class="cabecalho-secao">
            <div class="topo"><p class="rotulo">{g.rotulo}</p></div>
            <h2>{g.titulo}</h2>
          </div>

          <div class="lista">
            {g.perguntas.map((q) => (
              <details class="item">
                <summary>
                  <span class="pergunta">{q.p}</span>
                  <span class="marca" aria-hidden="true"></span>
                </summary>
                <div class="resposta corpo">
                  {q.r.map((t) => <p set:html={t} />)}
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    </>
  ))}

  <hr class="regua" />

  <section class="secao secao--curta">
    <div class="envelope">
      <div class="restante">
        <p class="rotulo">{c.fechoRotulo}</p>
        <p class="texto">{c.fechoTexto}</p>
        <div class="atalhos">
          <a class="botao botao--fantasma" href={c.atalhos[0].href}>{c.atalhos[0].texto}</a>
          <a class="botao botao--fantasma" href={c.atalhos[1].href}>{c.atalhos[1].texto}</a>
          <a class="botao botao--fantasma" href={c.atalhos[2].href}>{c.atalhos[2].texto}</a>
        </div>
      </div>
    </div>
  </section>

  <ListaEspera />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(dadosEstruturados)}
    is:inline
  />
</Base>

<style>
  h1 { font-size: clamp(2.4rem, 6vw, 4.6rem); }

  /* A abertura não precisa do respiro cheio embaixo: o primeiro grupo é a
     razão de o leitor estar aqui, e 161px de vazio empurravam ele para fora
     da primeira tela em 1280×720. */
  .abertura {
    position: relative;
    overflow: hidden;
    padding-bottom: clamp(20px, 3vh, 36px);
  }
  .abertura .cabecalho-secao { margin-bottom: 0; }
  .selo-fundo {
    position: absolute;
    right: -1%;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(11rem, 24vw, 22rem);
    line-height: 1;
    color: #fff;
    opacity: .02;
    pointer-events: none;
    user-select: none;
  }
  .abertura .envelope { position: relative; z-index: 1; }

  /* ---------- a lista ---------- */

  .lista {
    max-width: 82ch;
    border-top: 1px solid var(--linha);
  }

  .item { border-bottom: 1px solid var(--linha); }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 64px;          /* alvo de toque confortável */
    padding: 16px 0;
    cursor: pointer;
    list-style: none;          /* fora o triângulo nativo */
    transition: color .18s ease;
  }
  summary::-webkit-details-marker { display: none; }

  .pergunta {
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: clamp(1.02rem, 1.5vw, 1.2rem);
    letter-spacing: .045em;
    line-height: 1.35;
    color: var(--cinza);
    transition: color .18s ease;
  }
  summary:hover .pergunta,
  .item[open] .pergunta { color: var(--osso); }

  /* Marcador: cruz que vira traço ao abrir. Duas barras, sem fonte de ícone. */
  .marca {
    position: relative;
    flex: none;
    width: 15px;
    height: 15px;
  }
  .marca::before,
  .marca::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto 0;
    height: 1.5px;
    background: var(--poeira);
    transition: transform .22s ease, background .18s ease;
  }
  .marca::after { transform: rotate(90deg); }
  summary:hover .marca::before,
  summary:hover .marca::after { background: var(--osso); }

  .item[open] .marca::before,
  .item[open] .marca::after { background: var(--sangue-vivo); }
  .item[open] .marca::after { transform: rotate(0deg); }

  .resposta {
    padding: 2px 0 30px;
    max-width: 68ch;
    color: var(--cinza);
    font-size: .99rem;
  }
  .resposta p + p { margin-top: 1.05em; }
  .resposta a {
    color: var(--osso);
    text-decoration: underline;
    text-decoration-color: var(--linha-forte);
    text-underline-offset: 4px;
    transition: text-decoration-color .18s ease;
  }
  .resposta a:hover { text-decoration-color: var(--sangue-vivo); }
  .resposta b { color: var(--osso); font-weight: 600; }

  @media (prefers-reduced-motion: reduce) {
    summary, .pergunta, .marca::before, .marca::after { transition: none; }
  }

  /* ---------- fecho ---------- */

  .restante { max-width: 68ch; }
  .restante .texto {
    margin: 14px 0 0;
    color: var(--cinza);
  }
  .atalhos {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  @media (max-width: 560px) {
    summary { gap: 16px; }
    .atalhos .botao { width: 100%; }
  }
</style>
