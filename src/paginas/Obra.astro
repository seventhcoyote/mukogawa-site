---
import Base from "../layouts/Base.astro";
import { OBRA } from "../i18n/conteudo/obra";
import { rota } from "../i18n/idiomas";
import type { Idioma } from "../i18n/idiomas";

interface Props { idioma: Idioma }
const { idioma } = Astro.props;
const c = OBRA[idioma];
const hrefFaq = rota("faq", idioma);

// Sem arte, e é decisão registrada: não existe ilustração para as oito obras, e
// dar uma só a uma delas faria aquela parte da história parecer valer mais. A
// página se sustenta no mesmo sistema tipográfico de "Três séries" — numeral
// grande em Mincho, rótulo com // e filete —, que escala de três para oito sem
// pedir uma imagem sequer.
//
// As quatro últimas abrem recolhidas: da Saga III em diante a sinopse conta o
// rumo, e Desvelar entrega o desfecho. Numa página que se rola de cima a baixo,
// o leitor toparia com o fim sem ter escolhido.
---

<Base titulo={c.titulo} descricao={c.descricao}>
  <section class="secao abertura">
    <span class="selo-fundo" aria-hidden="true">巻</span>
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">{c.rotulo}</p></div>
        <h1>{c.h1}</h1>
        <p class="lead">
          {c.lead} <a class="link-varre" href={hrefFaq}>{c.notaOrdem}</a>
        </p>
      </div>
    </div>
  </section>

  <section class="secao secao--curta">
    <div class="envelope">
      <ol class="obras">
        {c.obras.map((o) => (
          <li>
            <span class="num" aria-hidden="true">{o.num}</span>

            <div class="conteudo">
              <h2>{o.nome}</h2>
              <p class="rotulo selo">{o.selo}</p>

              {o.aberta ? (
                <div class="sinopse">
                  {o.sinopse.map((p) => <p>{p}</p>)}
                </div>
              ) : (
                <details class="velada">
                  <summary>
                    <span class="aviso">{c.avisoRecolhida}</span>
                    <span class="acao">{c.abrir}</span>
                    <span class="sinal" aria-hidden="true"></span>
                  </summary>
                  <div class="sinopse">
                    {o.sinopse.map((p) => <p>{p}</p>)}
                  </div>
                </details>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  .abertura { position: relative; overflow: hidden; }
  .abertura h1 { font-size: clamp(2rem, 5vw, 4rem); max-width: 16ch; }
  .abertura .lead { margin-top: 22px; }
  .selo-fundo {
    position: absolute;
    right: -2%; top: -10%;
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(16rem, 34vw, 34rem);
    line-height: 1;
    color: #fff;
    opacity: .025;
    pointer-events: none;
    user-select: none;
  }

  .obras {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--linha);
    border: 1px solid var(--linha);
  }
  .obras li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(20px, 3vw, 46px);
    padding: clamp(26px, 3.4vw, 46px);
    background: var(--tinta);
  }
  .obras .num {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1;
    color: #63636f;   /* 3,1:1 no fundo: numeral discreto, mas legível */
  }
  .obras h2 { font-size: clamp(1.4rem, 2.4vw, 2rem); margin-bottom: 10px; }
  .obras .selo { margin-bottom: 20px; color: var(--sangue-vivo); }
  .sinopse p { color: var(--cinza); max-width: 68ch; }
  .sinopse p + p { margin-top: 1.1em; }

  /* ---------- as recolhidas ---------- */
  .velada summary {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 16px;
    min-height: 48px;
    padding: 0 18px;
    cursor: pointer;
    list-style: none;
    border: 1px dashed var(--linha-forte);
    transition: border-color .2s ease, background .2s ease;
  }
  .velada summary::-webkit-details-marker { display: none; }
  .velada summary:hover { background: var(--tinta-2); border-color: var(--poeira); }
  .velada summary:focus-visible {
    outline: 2px solid var(--sangue-vivo);
    outline-offset: 2px;
  }
  /* O aviso vem antes da ação de propósito: a pessoa lê o risco e só depois o
     convite. Invertido, o olho pega "Ler a sinopse" primeiro e o aviso vira
     legenda de rodapé. */
  .velada .aviso {
    font-family: var(--fonte-ui);
    font-size: .78rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--sangue-vivo);
  }
  .velada .acao {
    font-family: var(--fonte-ui);
    font-size: .82rem;
    letter-spacing: .12em;
    color: var(--poeira);
    margin-left: auto;
  }
  .velada .sinal {
    width: 8px; height: 8px;
    border-right: 1px solid var(--poeira);
    border-bottom: 1px solid var(--poeira);
    transform: translateY(-2px) rotate(45deg);
    transition: transform .25s ease;
  }
  .velada[open] .sinal { transform: translateY(1px) rotate(-135deg); }
  .velada[open] summary { margin-bottom: 24px; }

  @media (max-width: 900px) {
    .obras li { grid-template-columns: 1fr; gap: 10px; }
    .velada .acao { margin-left: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .velada summary, .velada .sinal { transition: none; }
  }
</style>
