---
/**
 * A capa do yomikiri.
 *
 * Houve aqui uma versão animada e colorida, que saiu por decisão do dono da
 * arte: a capa é peça acabada em preto e branco, e a pintura não o representa.
 * Ficou a arte como ela é. De quebra, o site perdeu 800 KB de vídeo.
 *
 * A capa tem moldura branca e crédito impresso: é peça acabada. Num site preto
 * ela só funciona tratada como OBJETO — lombada, sombra e um leve giro. Colada,
 * viraria o retângulo que este projeto recusa.
 *
 */
interface Props {
  alt: string;
  /** Largura máxima da peça. */
  largura?: string;
  /** Giro em graus. Zero por padrão: a capa tem moldura branca reta, e mesmo
   *  1,4 grau de rotação serrilha essa borda de alto contraste. */
  giro?: number;
  classe?: string;
}
const { alt, largura = "100%", giro = 0, classe = "" } = Astro.props;
---

<figure
  class:list={["capa-volume", classe]}
  style={`--largura:${largura}; --giro:${giro}deg`}
  data-capa
>
  <img class="poster" src="/video/capa-volume-1-poster.jpg" alt={alt} loading="lazy" decoding="async" />
  <span class="lombada" aria-hidden="true"></span>
</figure>

<style>
  .capa-volume {
    position: relative;
    margin: 0;
    width: 100%;
    max-width: var(--largura);
    transform: rotate(var(--giro));
    transition: transform .5s cubic-bezier(.2, .8, .2, 1);
  }

  .capa-volume :global(img) {
    display: block;
    width: 100%;
    height: auto;
    box-shadow:
      0 2px 0 rgba(255, 255, 255, .06),
      -10px 0 22px -12px rgba(0, 0, 0, .9),
      0 30px 56px -26px rgba(0, 0, 0, 1),
      0 0 84px -28px color-mix(in srgb, var(--sangue) 60%, transparent);
  }

  /* a espessura do volume, do lado da lombada */
  .lombada {
    position: absolute;
    inset: 2% auto 2% -8px;
    width: 8px;
    background: linear-gradient(90deg, #16161a, #2a2a31 55%, #0a0a0c);
    box-shadow: inset -1px 0 0 rgba(0, 0, 0, .8);
    pointer-events: none;
  }

  .capa-volume:hover { transform: rotate(var(--giro)) translateY(-5px); }

  @media (prefers-reduced-motion: reduce) {
    .capa-volume,
    .capa-volume:hover { transition: none; transform: rotate(var(--giro)); }
  }
</style>
