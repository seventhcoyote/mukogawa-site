---
import { Image } from "astro:assets";
import capa from "../assets/video/leitura-dramatizada.jpg";

// O YouTube só entra quando a pessoa clica. Carregar o player junto com a home
// custaria mais de 1 MB de script e ainda deixaria a Google rastreando quem
// nem assistiu. Antes do clique existe só a capa, servida do nosso domínio.
const VIDEO_ID = "IEQqYgudmh8";
---

<section class="gosto secao" id="gosto-da-narrativa">
  <span class="selo" aria-hidden="true">聴</span>

  <div class="envelope">
    <div class="cabecalho-secao">
      <div class="topo"><p class="rotulo">Leitura dramatizada</p></div>
      <div class="linha-titulo">
        <h2>Um Gosto da Narrativa</h2>
        <p class="apoio">
          Um trecho da obra, narrado. É a forma mais rápida de sentir o tom
          antes do primeiro volume.
        </p>
      </div>
    </div>

    <div class="palco" data-video={VIDEO_ID}>
      <button class="capa" type="button" aria-label="Assistir à leitura dramatizada de Mukō-Gawa no YouTube">
        <Image
          src={capa}
          alt=""
          widths={[640, 1000, 1280]}
          sizes="(max-width: 900px) 92vw, 1100px"
          loading="lazy"
        />
        <span class="halftone" aria-hidden="true"></span>
        <span class="veu" aria-hidden="true"></span>
        <span class="play" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
            <path d="M8 5.2v13.6L19.5 12z" />
          </svg>
        </span>
        <span class="dica" aria-hidden="true">Assistir no YouTube</span>
      </button>
      <span class="cantos" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .gosto {
    position: relative;
    overflow: hidden;
    background: var(--tinta-2);
    border-block: 1px solid var(--linha);
  }

  .selo {
    position: absolute;
    left: -3%; top: 50%;
    transform: translateY(-50%);
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(12rem, 28vw, 28rem);
    line-height: 1;
    color: #fff;
    opacity: .025;
    pointer-events: none;
    user-select: none;
  }

  .envelope { position: relative; z-index: 1; }

  .linha-titulo {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }
  .apoio { margin: 0; max-width: 42ch; color: var(--cinza); }

  .palco {
    position: relative;
    max-width: 1100px;
    margin-inline: auto;
  }

  .capa {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 1px solid var(--linha-forte);
    background: var(--vazio);
    cursor: pointer;
    overflow: hidden;
    clip-path: polygon(20px 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%, 0 20px);
  }
  .capa :global(img) {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform .7s cubic-bezier(.16,.84,.28,1), filter .4s ease;
  }
  .capa .halftone { color: #000; opacity: .14; }
  .capa .veu {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 60% 60% at 50% 50%, transparent, color-mix(in srgb, var(--vazio) 55%, transparent));
    transition: opacity .4s ease;
  }

  .play {
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    width: 82px; height: 82px;
    display: grid;
    place-items: center;
    color: #fff;
    background: var(--sangue);
    clip-path: polygon(16px 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%, 0 16px);
    transition: transform .35s cubic-bezier(.16,.84,.28,1), background .25s ease;
  }
  .play svg { margin-left: 3px; }

  .dica {
    position: absolute;
    left: 50%; bottom: 26px;
    transform: translateX(-50%);
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: .78rem;
    letter-spacing: .28em;
    text-transform: uppercase;
    color: var(--osso);
    opacity: .82;
  }

  .capa:hover :global(img) { transform: scale(1.04); }
  .capa:hover .veu { opacity: .5; }
  .capa:hover .play { transform: translate(-50%, -50%) scale(1.08); background: #ee2b35; }
  .capa:focus-visible { outline: 2px solid var(--sangue-vivo); outline-offset: 4px; }

  .cantos {
    position: absolute; inset: -12px;
    pointer-events: none;
    background:
      linear-gradient(var(--sangue), var(--sangue)) 0 0 / 1px 44px no-repeat,
      linear-gradient(var(--sangue), var(--sangue)) 0 0 / 44px 1px no-repeat,
      linear-gradient(var(--sangue), var(--sangue)) 100% 100% / 1px 44px no-repeat,
      linear-gradient(var(--sangue), var(--sangue)) 100% 100% / 44px 1px no-repeat;
  }

  /* o iframe herda a mesma moldura quando entra */
  .palco :global(iframe) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--linha-forte);
    background: var(--vazio);
    clip-path: polygon(20px 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%, 0 20px);
  }

  @media (prefers-reduced-motion: reduce) {
    .capa :global(img), .play, .veu { transition: none; }
    .capa:hover :global(img) { transform: none; }
  }

  @media (max-width: 640px) {
    .play { width: 64px; height: 64px; }
    .dica { bottom: 16px; font-size: .7rem; }
  }
</style>

<script>
  const palco = document.querySelector<HTMLElement>(".gosto .palco");
  const botao = palco?.querySelector<HTMLButtonElement>(".capa");

  botao?.addEventListener("click", () => {
    const id = palco!.dataset.video;
    const frame = document.createElement("iframe");
    frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
    frame.title = "Leitura dramatizada de Mukō-Gawa";
    frame.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share";
    frame.referrerPolicy = "strict-origin-when-cross-origin";
    frame.allowFullscreen = true;
    palco!.replaceChildren(frame);
    frame.focus();
  });
</script>
