---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { PersonagemIdioma } from "../i18n/conteudo/personagens";
import { ROTULOS_PERSONAGENS } from "../i18n/conteudo/personagens";
import { rota, idiomaDaUrl } from "../i18n/idiomas";

interface Props {
  p: PersonagemIdioma;
  /** Prioriza o carregamento dos primeiros cards visíveis. */
  prioridade?: boolean;
}

const { p, prioridade = false } = Astro.props;

const arquivos = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/personagens/*.jpg",
  { eager: true },
);
const arte = arquivos[`../assets/personagens/${p.slug}.jpg`]?.default;

const idioma = idiomaDaUrl(Astro.url.pathname);
const rot = ROTULOS_PERSONAGENS[idioma];
const base = rota("personagens", idioma);
if (!arte) throw new Error(`Arte não encontrada para "${p.slug}"`);
---

<a class="card" data-lado={p.lado} href={`${base}/${p.slug}`}>
  <span class="palco">
    <span class="aura" aria-hidden="true"></span>
    <span class="linhas" aria-hidden="true"></span>
    <span class="selo" aria-hidden="true">{p.kanji}</span>

    <Image
      class="arte"
      src={arte}
      alt={`${p.nome} — ${p.epiteto}`}
      widths={[320, 520, 1000]}
      sizes="(max-width: 620px) 46vw, (max-width: 1080px) 30vw, 24vw"
      loading={prioridade ? "eager" : "lazy"}
      fetchpriority={prioridade ? "high" : "auto"}
    />

    <span class="brasas" aria-hidden="true">
      <i></i><i></i><i></i><i></i><i></i><i></i>
    </span>
    <span class="corte" aria-hidden="true"></span>
    <span class="cantos" aria-hidden="true"></span>
  </span>

  <span class="ficha">
    <span class="classe">{rot.classe} {p.classeNum} // {p.classe}</span>
    <span class="nome">{p.nome}</span>
    <span class="epiteto">{p.epiteto}</span>
  </span>
</a>

<style>
  .card {
    --dur: .55s;
    --mola: cubic-bezier(.16, .84, .28, 1);
    display: block;
    text-decoration: none;
    position: relative;
    transition: opacity .35s ease, filter .35s ease, transform var(--dur) var(--mola);
  }

  /* ---------- palco: onde a aura acontece ---------- */

  /* Moldura 4:5 idêntica em todos os cards. As artes já são geradas em 4:5
     com a figura inteira dentro e a mesma ocupação de área (46%), então
     "cover" aqui não corta um pixel sequer. */
  .palco {
    display: block;
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--vazio);
    isolation: isolate;               /* contém o blend do traço */
    border: 1px solid var(--linha);
    clip-path: polygon(18px 0, 100% 0, 100% calc(100% - 18px), calc(100% - 18px) 100%, 0 100%, 0 18px);
  }

  /* A arte é traço branco sobre preto. Em "screen" o preto some e o
     traço flutua sobre o que estiver atrás: a aura passa a vir de dentro. */
  .arte {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 2;
    mix-blend-mode: screen;
    filter: grayscale(1) contrast(1.04);
    transform: scale(1.005);
    transition: transform var(--dur) var(--mola), filter var(--dur) ease;
  }

  /* pressão espiritual */
  .aura {
    position: absolute;
    inset: -18%;
    z-index: 0;
    background:
      radial-gradient(ellipse 58% 52% at 50% 58%, var(--lado-fundo) 0%, transparent 68%),
      radial-gradient(ellipse 34% 30% at 50% 62%, var(--lado) 0%, transparent 72%);
    opacity: 0;
    transform: scale(.55);
    transition: opacity var(--dur) ease, transform var(--dur) var(--mola);
  }

  /* linhas de concentração */
  .linhas {
    position: absolute;
    inset: -30%;
    z-index: 1;
    background: repeating-conic-gradient(
      from 0deg at 50% 55%,
      transparent 0deg 1.7deg,
      rgba(255, 255, 255, .5) 1.7deg 2.1deg
    );
    -webkit-mask-image: radial-gradient(circle at 50% 55%, transparent 26%, #000 68%);
    mask-image: radial-gradient(circle at 50% 55%, transparent 26%, #000 68%);
    opacity: 0;
    transform: scale(1.5);
    transition: opacity .4s ease, transform .6s var(--mola);
  }

  /* selo da classe */
  .selo {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    font-family: var(--fonte-display);
    font-size: clamp(7rem, 17vw, 12rem);
    font-weight: 700;
    color: #fff;
    opacity: 0;
    transform: scale(.86);
    transition: opacity var(--dur) ease, transform var(--dur) var(--mola);
  }

  /* brasas subindo */
  .brasas {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    opacity: 0;
    transition: opacity .3s ease;
  }
  .brasas i {
    position: absolute;
    bottom: -6px;
    width: 3px;
    height: 3px;
    background: var(--lado);
    border-radius: 50%;
  }
  .brasas i:nth-child(1) { left: 18%; }
  .brasas i:nth-child(2) { left: 33%; }
  .brasas i:nth-child(3) { left: 47%; }
  .brasas i:nth-child(4) { left: 61%; }
  .brasas i:nth-child(5) { left: 74%; }
  .brasas i:nth-child(6) { left: 88%; }

  /* o corte */
  .corte {
    position: absolute;
    top: -20%;
    left: -40%;
    z-index: 4;
    width: 45%;
    height: 140%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, .06) 38%,
      rgba(255, 255, 255, .9) 50%,
      rgba(255, 255, 255, .06) 62%,
      transparent
    );
    transform: rotate(18deg) translateX(-60%);
    opacity: 0;
    pointer-events: none;
    mix-blend-mode: screen;
  }

  /* marcas de canto */
  .cantos {
    position: absolute;
    inset: 12px;
    z-index: 6;
    pointer-events: none;
    opacity: 0;
    transition: opacity .3s ease;
    background:
      linear-gradient(var(--lado), var(--lado)) 0 0 / 1px 22px no-repeat,
      linear-gradient(var(--lado), var(--lado)) 0 0 / 22px 1px no-repeat,
      linear-gradient(var(--lado), var(--lado)) 100% 100% / 1px 22px no-repeat,
      linear-gradient(var(--lado), var(--lado)) 100% 100% / 22px 1px no-repeat;
  }

  /* ---------- ficha ---------- */

  .ficha {
    display: grid;
    gap: 6px;
    padding: 16px 2px 0;
  }
  .classe {
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: .7rem;
    letter-spacing: .26em;
    text-transform: uppercase;
    color: var(--poeira);
    transition: color .3s ease;
  }
  .nome {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    line-height: 1.1;
    color: var(--osso);
    display: block;
  }
  .epiteto {
    font-family: var(--fonte-ui);
    font-weight: 500;
    font-size: .84rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--cinza);
  }

  /* ---------- o estado aceso ---------- */

  .card:is(:hover, :focus-visible) .aura { opacity: .95; transform: scale(1); }
  .card:is(:hover, :focus-visible) .linhas { opacity: .3; transform: scale(1); }
  .card:is(:hover, :focus-visible) .selo { opacity: .1; transform: scale(1); }
  .card:is(:hover, :focus-visible) .cantos { opacity: .9; }
  .card:is(:hover, :focus-visible) .brasas { opacity: 1; }
  .card:is(:hover, :focus-visible) .arte { transform: scale(1.05); filter: grayscale(0) contrast(1.1); }
  .card:is(:hover, :focus-visible) .classe { color: var(--lado); }
  .card:is(:hover, :focus-visible) { transform: translateY(-6px); }

  @media (prefers-reduced-motion: no-preference) {
    .card:is(:hover, :focus-visible) .corte { animation: corte .62s var(--mola) forwards; }
    .card:is(:hover, :focus-visible) .brasas i { animation: subir 2.6s linear infinite; }
    .brasas i:nth-child(1) { animation-delay: 0s; }
    .brasas i:nth-child(2) { animation-delay: .45s; }
    .brasas i:nth-child(3) { animation-delay: .9s; }
    .brasas i:nth-child(4) { animation-delay: 1.3s; }
    .brasas i:nth-child(5) { animation-delay: 1.75s; }
    .brasas i:nth-child(6) { animation-delay: 2.1s; }
  }

  @keyframes corte {
    0%   { opacity: 0; transform: rotate(18deg) translateX(-60%); }
    12%  { opacity: 1; }
    88%  { opacity: 1; }
    100% { opacity: 0; transform: rotate(18deg) translateX(340%); }
  }

  @keyframes subir {
    0%   { opacity: 0; transform: translateY(0) scale(.6); }
    12%  { opacity: .9; }
    80%  { opacity: .5; }
    100% { opacity: 0; transform: translateY(-260px) scale(1.25); }
  }

  @media (prefers-reduced-motion: reduce) {
    .card, .arte, .aura, .linhas, .selo, .cantos { transition-duration: .01ms; }
    .card:is(:hover, :focus-visible) { transform: none; }
    .card:is(:hover, :focus-visible) .arte { transform: none; }
    .card:is(:hover, :focus-visible) .linhas { opacity: 0; }
    .corte, .brasas { display: none; }
  }
</style>
