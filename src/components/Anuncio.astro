---
import { INICIO } from "../i18n/conteudo/inicio";
import { idiomaDaUrl } from "../i18n/idiomas";

// O anúncio do lançamento é a informação mais importante do site. Desde
// 2026-08-02 o que sai primeiro é o YOMIKIRI (o piloto), não o volume 1.
// No site antigo era uma tarja de 104px com fundo três níveis acima do fundo
// da página. Aqui ele é um bloco, com data em display e contagem regressiva.
// Data confirmada pelo autor em 2026-08-02: 1º de dezembro de 2026.
const ALVO = "2026-12-01T00:00:00-03:00";

const c = INICIO[idiomaDaUrl(Astro.url.pathname)];
---

<section class="anuncio" id="anuncio">
  <span class="halftone" aria-hidden="true"></span>

  <div class="envelope interno">
    <div class="texto">
      <p class="rotulo">{c.anuncioRotulo}</p>
      <p class="frase">{c.anuncioAntes}<strong>{c.anuncioForte}</strong>{c.anuncioDepois}</p>
    </div>

    <div class="contagem" data-alvo={ALVO} data-aria={c.anuncioAria(0).replace("0", "{n}")}>
      <span class="numero" data-dias>—</span>
      <span class="unidade">{c.anuncioDias}</span>
    </div>

    <a class="botao" href="#lista-de-espera">{c.aviseMe}</a>
  </div>
</section>

<style>
  .anuncio {
    position: relative;
    overflow: hidden;
    background: linear-gradient(100deg, var(--sangue) 0%, #8f1119 62%, #4a0a0e 100%);
    border-block: 1px solid #6b0d13;
  }
  .anuncio .halftone { color: #000; opacity: .22; }

  .interno {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(20px, 3vw, 44px);
    padding-block: clamp(30px, 4vw, 46px);
  }

  .texto { flex: 1 1 320px; }

  .rotulo { color: #ffd9db; margin-bottom: 10px; }

  .frase {
    margin: 0;
    font-family: var(--fonte-display);
    font-weight: 600;
    font-size: clamp(1.15rem, 2.1vw, 1.7rem);
    line-height: 1.3;
    color: #fff;
    max-width: 30ch;
  }
  .frase strong { font-weight: 700; white-space: nowrap; }

  /* O contador é o elemento com mais potencial dramático da página. Chegou a
     ter uma brasa por baixo — dois gradientes radiais pulsando — para o número
     não se perder no vermelho. Não lia como fogo, lia como borrão sobre a arte,
     e saiu por decisão do Bruno. O que segura o número agora é o próprio peso:
     4,4rem em display sobre o vermelho dá 5,3:1 de contraste, acima de AA.
     As bordas verticais e a sombra fixa fazem o resto. */
  .contagem {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding-inline: clamp(18px, 2.5vw, 34px);
    border-inline: 1px solid rgba(255, 255, 255, .22);
  }
  .numero {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    line-height: 1;
    color: #fff;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 1px 12px rgba(0, 0, 0, .35);
  }
  .unidade {
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: .9rem;
    letter-spacing: .3em;
    text-transform: uppercase;
    color: #ffd9db;
  }

  .interno .botao {
    --bg: #fff;
    --fg: #6b0d13;
    border-color: #fff;
  }
  .interno .botao:hover { background: #ffe3e5; border-color: #ffe3e5; color: #6b0d13; }

  @media (max-width: 720px) {
    .contagem { border-inline: 0; padding-inline: 0; }
    .interno .botao { width: 100%; }
  }

</style>

<script>
  const caixa = document.querySelector<HTMLElement>(".contagem");
  if (caixa) {
    const alvo = new Date(caixa.dataset.alvo!).getTime();
    const saida = caixa.querySelector<HTMLElement>("[data-dias]")!;
    const restam = Math.max(0, Math.ceil((alvo - Date.now()) / 86_400_000));
    saida.setAttribute("aria-label", caixa.dataset.aria!.replace("{n}", String(restam)));

    // O valor correto é escrito JÁ. requestAnimationFrame não dispara em aba
    // oculta (ctrl+clique, sessão restaurada), e sem isto o contador ficava em
    // "—" até a aba ganhar foco. A animação apenas passa por cima.
    saida.textContent = String(restam);

    // Sobe de 0 até o número real: transforma um dado estático em acontecimento.
    const semMovimento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!semMovimento && restam > 0 && !document.hidden) {
      const duracao = 900;
      const inicio = performance.now();
      const passo = (agora: number) => {
        const t = Math.min(1, (agora - inicio) / duracao);
        const suave = 1 - Math.pow(1 - t, 3);
        saida.textContent = String(Math.round(restam * suave));
        if (t < 1) requestAnimationFrame(passo);
      };
      requestAnimationFrame(passo);
    }
  }
</script>
