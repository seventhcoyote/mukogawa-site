---
// O anúncio do volume 1 é a informação mais importante do site.
// No site antigo era uma tarja de 104px com fundo três níveis acima do fundo
// da página. Aqui ele é um bloco, com data em display e contagem regressiva.
const ALVO = "2026-12-01T00:00:00-03:00";
---

<section class="anuncio" id="anuncio">
  <span class="halftone" aria-hidden="true"></span>

  <div class="envelope interno">
    <div class="texto">
      <p class="rotulo">Anúncio</p>
      <p class="frase">
        O primeiro volume do mangá chega em
        <strong>dezembro de 2026</strong>. A série de livros começa em 2027.
      </p>
    </div>

    <div class="contagem" data-alvo={ALVO}>
      <span class="numero" data-dias>—</span>
      <span class="unidade">dias</span>
    </div>

    <a class="botao" href="#lista-de-espera">Avise-me</a>
  </div>
</section>

<style>
  .anuncio {
    position: relative;
    overflow: hidden;
    background: linear-gradient(100deg, var(--sangue) 0%, #8f1119 62%, #4a0a0e 100%);
    border-block: 1px solid #6b0d13;
  }
  .anuncio .halftone { color: #000; opacity: .22; }

  .interno {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(20px, 3vw, 44px);
    padding-block: clamp(30px, 4vw, 46px);
  }

  .texto { flex: 1 1 320px; }

  .rotulo { color: #ffd9db; margin-bottom: 10px; }

  .frase {
    margin: 0;
    font-family: var(--fonte-display);
    font-weight: 600;
    font-size: clamp(1.15rem, 2.1vw, 1.7rem);
    line-height: 1.3;
    color: #fff;
    max-width: 30ch;
  }
  .frase strong { font-weight: 700; white-space: nowrap; }

  .contagem {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding-inline: clamp(18px, 2.5vw, 34px);
    border-inline: 1px solid rgba(255, 255, 255, .22);
  }
  .numero {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    line-height: 1;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .unidade {
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: .9rem;
    letter-spacing: .3em;
    text-transform: uppercase;
    color: #ffd9db;
  }

  .interno .botao {
    --bg: #fff;
    --fg: #6b0d13;
    border-color: #fff;
  }
  .interno .botao:hover { background: #ffe3e5; border-color: #ffe3e5; color: #6b0d13; }

  @media (max-width: 720px) {
    .contagem { border-inline: 0; padding-inline: 0; }
    .interno .botao { width: 100%; }
  }
</style>

<script>
  const caixa = document.querySelector<HTMLElement>(".contagem");
  if (caixa) {
    const alvo = new Date(caixa.dataset.alvo!).getTime();
    const saida = caixa.querySelector<HTMLElement>("[data-dias]")!;
    const restam = Math.max(0, Math.ceil((alvo - Date.now()) / 86_400_000));
    saida.textContent = String(restam);
    saida.setAttribute("aria-label", `${restam} dias para o lançamento`);
  }
</script>
