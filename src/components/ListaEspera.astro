---
import { idiomaDaUrl } from "../i18n/idiomas";
import { usarUI } from "../i18n/ui";

// A loja ainda não existe: enquanto isso, o site converte para lista de espera.
// O endpoint é plugável (Formspree, Buttondown, Beehiiv, função na Vercel).
// Sem PUBLIC_WAITLIST_ENDPOINT o formulário se declara inativo em vez de
// fingir que gravou o e-mail.
const endpoint = import.meta.env.PUBLIC_WAITLIST_ENDPOINT ?? "";

const idioma = idiomaDaUrl(Astro.url.pathname);
const t = usarUI(idioma);

// As mensagens do script vivem em data-* porque o <script> do Astro é
// processado à parte e não enxerga o escopo do frontmatter.
const recados = {
  erroEmail: t("espera.erroEmail"),
  semEndpoint: t("espera.semEndpoint"),
  enviando: t("espera.enviando"),
  ok: t("espera.ok"),
  erroEnvio: t("espera.erroEnvio"),
};

const REGIOES = ["BR", "US", "JP", "OUTRO"] as const;
---

<section class="espera secao" id="lista-de-espera">
  <span class="halftone" aria-hidden="true"></span>
  <span class="selo" aria-hidden="true">壱</span>

  <div class="envelope interno">
    <p class="rotulo rotulo--lado" data-lado="rebeldes">{t("espera.rotulo")}</p>

    <h2>{t("espera.titulo")}</h2>

    <p class="apoio">
      {t("espera.apoio")}
    </p>

    <form class="formulario" data-endpoint={endpoint} data-recados={JSON.stringify(recados)} novalidate>
      <div class="campos">
        <div class="campo">
          <label class="so-leitor" for="email-espera">{t("espera.email")}</label>
          <input
            id="email-espera"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            placeholder={t("espera.email")}
            required
          />
        </div>

        <div class="campo campo--regiao">
          <label class="so-leitor" for="regiao-espera">{t("espera.regiao")}</label>
          <select id="regiao-espera" name="regiao">
            {REGIOES.map((r) => (
              <option value={r}>{t(`regiao.${r}` as any)}</option>
            ))}
          </select>
        </div>

        <button class="botao" type="submit">{t("espera.botao")}</button>
      </div>

      <!-- armadilha simples contra robô -->
      <div class="ninho" aria-hidden="true">
        <label for="empresa-espera">{t("espera.naoPreencha")}</label>
        <input id="empresa-espera" name="empresa" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <p class="recado" role="status" aria-live="polite"></p>
    </form>

    <p class="rodape-nota">
      {t("espera.nota")}
    </p>
  </div>
</section>

<style>
  .espera {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 120% at 12% 100%, color-mix(in srgb, var(--sangue) 26%, transparent), transparent 62%),
      var(--tinta-2);
    border-block: 1px solid var(--linha);
  }
  .espera .halftone { color: var(--sangue); opacity: .1; }

  .selo {
    position: absolute;
    right: -2%;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(12rem, 26vw, 26rem);
    line-height: 1;
    color: #fff;
    opacity: .022;
    pointer-events: none;
    user-select: none;
  }

  .interno { position: relative; z-index: 1; max-width: 780px; }

  h2 { margin: 20px 0 18px; }
  .apoio { color: var(--cinza); max-width: 52ch; margin-bottom: 30px; }

  .campos {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .campo { flex: 1 1 240px; min-width: 0; }
  .campo--regiao { flex: 0 1 190px; }

  input[type="email"],
  select {
    width: 100%;
    min-height: 52px;
    padding: 0 16px;
    background: var(--vazio);
    border: 1px solid var(--linha-forte);
    color: var(--osso);
    font-family: var(--fonte-ui);
    font-size: 1rem;
    letter-spacing: .04em;
    clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);
  }
  input::placeholder { color: var(--poeira); }
  input:focus-visible, select:focus-visible { border-color: var(--sangue-vivo); }
  input[aria-invalid="true"] { border-color: var(--sangue-vivo); }

  select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--poeira) 50%),
                      linear-gradient(135deg, var(--poeira) 50%, transparent 50%);
    background-position: calc(100% - 20px) 24px, calc(100% - 14px) 24px;
    background-size: 6px 6px, 6px 6px;
    background-repeat: no-repeat;
  }

  .campos .botao { flex: 0 0 auto; }

  .ninho {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .recado {
    margin: 16px 0 0;
    min-height: 1.5em;
    font-family: var(--fonte-ui);
    font-size: .92rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--poeira);
  }
  .recado[data-tom="erro"] { color: var(--sangue-vivo); }
  .recado[data-tom="ok"] { color: var(--aco); }

  .rodape-nota {
    margin: 34px 0 0;
    font-size: .9rem;
    color: var(--poeira);
    max-width: 56ch;
  }

  @media (max-width: 620px) {
    .campo, .campo--regiao { flex: 1 1 100%; }
    .campos .botao { width: 100%; }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>(".espera .formulario");
  if (form) {
    const recado = form.querySelector<HTMLParagraphElement>(".recado")!;
    const email = form.querySelector<HTMLInputElement>('input[type="email"]')!;
    const botao = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const armadilha = form.querySelector<HTMLInputElement>('input[name="empresa"]')!;
    const endpoint = form.dataset.endpoint ?? "";
    const recados = JSON.parse(form.dataset.recados ?? "{}") as Record<string, string>;

    const dizer = (texto: string, tom: "ok" | "erro" | "") => {
      recado.textContent = texto;
      if (tom) recado.dataset.tom = tom;
      else delete recado.dataset.tom;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (armadilha.value) return;

      const valor = email.value.trim();
      if (!valor || !email.checkValidity()) {
        email.setAttribute("aria-invalid", "true");
        dizer(recados.erroEmail, "erro");
        email.focus();
        return;
      }
      email.removeAttribute("aria-invalid");

      if (!endpoint) {
        dizer(recados.semEndpoint, "erro");
        return;
      }

      botao.disabled = true;
      dizer(recados.enviando, "");

      try {
        const resposta = await fetch(endpoint, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            email: valor,
            regiao: (form.querySelector<HTMLSelectElement>("select")!).value,
          }),
        });
        if (!resposta.ok) throw new Error(String(resposta.status));
        form.querySelector<HTMLDivElement>(".campos")!.hidden = true;
        dizer(recados.ok, "ok");
      } catch {
        botao.disabled = false;
        dizer(recados.erroEnvio, "erro");
      }
    });
  }
</script>
