---
import {
  IDIOMAS, ATIVOS, idiomaDaUrl, rota as caminho, equivalente,
} from "../i18n/idiomas";
import { usarUI } from "../i18n/ui";

const atual = Astro.url.pathname.replace(/\/$/, "") || "/";
const idioma = idiomaDaUrl(Astro.url.pathname);
const t = usarUI(idioma);

const links = ([
  ["inicio", "nav.inicio"],
  ["historia", "nav.historia"],
  ["personagens", "nav.personagens"],
  ["criadores", "nav.criadores"],
  ["loja", "nav.loja"],
  ["faq", "nav.faqCurto"],
] as const).map(([chave, rotulo]) => ({
  href: caminho(chave, idioma),
  texto: t(rotulo),
  raiz: chave === "inicio",
}));

const inicio = caminho("inicio", idioma);
const espera = `${inicio.replace(/\/$/, "")}/#lista-de-espera`;

const ativo = (href: string, raiz: boolean) => {
  const alvo = href.replace(/\/$/, "") || "/";
  return raiz ? atual === alvo : atual.startsWith(alvo);
};

// Um idioma só não é escolha: o seletor some enquanto EN e ES não existirem.
const idiomasLink = ATIVOS.length > 1 ? ATIVOS.map((outro) => ({
  ...IDIOMAS[outro],
  codigo: outro,
  href: equivalente(Astro.url.pathname, outro),
  atual: outro === idioma,
})) : [];
---

<header class="cabecalho">
  <div class="barra">
    <a class="marca" href={inicio} aria-label={t("nav.inicioAria")}>
      <span class="kanji" aria-hidden="true">向こう側</span>
      <span class="romaji">Mukō·Gawa</span>
    </a>

    <button
      class="hamburguer"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principal"
      aria-label={t("nav.abrirMenu")}
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <nav id="menu-principal" class="menu" aria-label={t("nav.principal")}>
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={ativo(l.href, l.raiz) ? "page" : undefined}>
              {l.texto}
            </a>
          </li>
        ))}
      </ul>

      {idiomasLink.length > 0 && (
      <ul class="idiomas" aria-label={t("cta.idioma")}>
        {idiomasLink.map((i) => (
          <li>
            <a
              href={i.href}
              hreflang={i.htmlLang}
              lang={i.htmlLang}
              aria-current={i.atual ? "true" : undefined}
            >
              <span class="so-leitor">{i.rotulo}</span>
              <span aria-hidden="true">{i.curto}</span>
            </a>
          </li>
        ))}
      </ul>
      )}

      <a class="cta" href={espera}>{t("cta.aviseMe")}</a>
    </nav>
  </div>
</header>

<style>
  .cabecalho {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    background: color-mix(in srgb, var(--tinta) 82%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--linha);
  }

  .barra {
    max-width: var(--max);
    margin-inline: auto;
    padding: 0 var(--gutter);
    height: 76px;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .marca {
    display: flex;
    min-height: 44px;
    flex-direction: column;
    justify-content: center;
    text-decoration: none;
    margin-right: auto;
    line-height: 1;
  }
  .kanji {
    font-family: var(--fonte-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--osso);
    letter-spacing: .04em;
  }
  .romaji {
    font-family: var(--fonte-ui);
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .42em;
    text-transform: uppercase;
    color: var(--poeira);
    margin-top: 5px;
  }

  .menu {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.4vw, 40px);
  }
  .menu ul {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 32px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu a {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    font-family: var(--fonte-ui);
    font-weight: 500;
    font-size: .92rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--cinza);
    position: relative;
    transition: color .18s ease;
  }
  .menu a:hover { color: var(--osso); }
  .menu a[aria-current="page"] { color: var(--osso); }
  .menu a[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 10px;
    height: 2px;
    background: var(--sangue);
  }

  /* Seletor de idioma: três siglas, separadas por filete, mais discretas que
     os itens de navegação. Não é destino, é ajuste — então não compete. */
  .menu .idiomas {
    gap: 0;
    border-inline: 1px solid var(--linha-forte);
  }
  .menu .idiomas li + li { border-left: 1px solid var(--linha-forte); }
  .menu .idiomas a {
    padding: 0 11px;
    font-size: .78rem;
    letter-spacing: .14em;
    color: var(--poeira);
  }
  .menu .idiomas a:hover { color: var(--osso); }
  .menu .idiomas a[aria-current="true"] { color: var(--osso); }
  .menu .idiomas a[aria-current="true"]::after {
    content: "";
    position: absolute;
    left: 11px; right: 11px; bottom: 10px;
    height: 2px;
    background: var(--sangue);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    background: var(--sangue);
    color: #fff !important;
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: .85rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    text-decoration: none;
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
    transition: background .18s ease;
  }
  .cta:hover { background: #ee2b35; }
  .cta::after { display: none !important; }

  /* ---------- hambúrguer ---------- */

  .hamburguer {
    display: none;
    width: 48px;
    height: 48px;
    padding: 0;
    background: none;
    border: 1px solid var(--linha-forte);
    cursor: pointer;
    position: relative;
  }
  .hamburguer span {
    position: absolute;
    left: 13px;
    width: 20px;
    height: 1.5px;
    background: var(--osso);
    transition: transform .26s cubic-bezier(.2,.8,.2,1), opacity .18s ease;
  }
  .hamburguer span:nth-child(1) { top: 17px; }
  .hamburguer span:nth-child(2) { top: 23px; }
  .hamburguer span:nth-child(3) { top: 29px; }
  .hamburguer[aria-expanded="true"] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .hamburguer[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .hamburguer[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  /* ---------- mobile ---------- */

  @media (max-width: 920px) {
    .hamburguer { display: block; order: 3; }

    .menu {
      position: fixed;
      inset: 76px 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--tinta);
      border-bottom: 1px solid var(--linha);
      padding: 8px var(--gutter) 28px;
      max-height: calc(100dvh - 76px);
      overflow-y: auto;
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition: opacity .2s ease, transform .2s ease, visibility .2s;
    }
    .menu[data-aberto="true"] {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    .menu ul { flex-direction: column; align-items: stretch; gap: 0; }
    .menu li { border-bottom: 1px solid var(--linha); }
    .menu a {
      min-height: 58px;
      font-size: 1.05rem;
      width: 100%;
    }
    .menu a[aria-current="page"]::after { bottom: 16px; width: 22px; right: auto; }
    .cta { margin-top: 22px; justify-content: center; min-height: 54px; }

    /* O seletor de idioma continua em linha: empilhar três siglas viraria
       três destinos falsos numa lista que já é de destinos. */
    .menu .idiomas {
      flex-direction: row;
      align-self: flex-start;
      margin-top: 22px;
      border: 1px solid var(--linha-forte);
    }
    .menu .idiomas li { border-bottom: 0; }
    .menu .idiomas a {
      min-height: 48px;
      width: auto;
      padding: 0 18px;
      font-size: .85rem;
    }
    .menu .idiomas a[aria-current="true"]::after { bottom: 10px; left: 18px; right: 18px; width: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu, .hamburguer span { transition: none; }
  }
</style>

<script>
  const botao = document.querySelector<HTMLButtonElement>(".hamburguer");
  const menu = document.getElementById("menu-principal");

  if (botao && menu) {
    const definir = (aberto: boolean) => {
      botao.setAttribute("aria-expanded", String(aberto));
      botao.setAttribute("aria-label", aberto ? "Fechar menu" : "Abrir menu");
      menu.dataset.aberto = String(aberto);
      document.body.style.overflow = aberto ? "hidden" : "";
    };

    botao.addEventListener("click", () => {
      definir(botao.getAttribute("aria-expanded") !== "true");
    });

    menu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) definir(false);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && botao.getAttribute("aria-expanded") === "true") {
        definir(false);
        botao.focus();
      }
    });

    // Se a janela cresce além do breakpoint, o menu volta ao estado de desktop.
    const mq = window.matchMedia("(min-width: 921px)");
    mq.addEventListener("change", (e) => { if (e.matches) definir(false); });
  }
</script>
