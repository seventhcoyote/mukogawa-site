---
import {
  IDIOMAS, ATIVOS, idiomaDaUrl, rota as caminho, equivalente,
} from "../i18n/idiomas";
import { usarUI } from "../i18n/ui";

const atual = Astro.url.pathname.replace(/\/$/, "") || "/";
const idioma = idiomaDaUrl(Astro.url.pathname);
const t = usarUI(idioma);

 // "Início" chegou a sair do menu quando "A obra" entrou, pelo argumento de que a
// marca já leva à home. O argumento é uma convenção real, mas falhou no teste:
// aqui a marca é KANJI, sem nenhuma afordância visual de link, e quem conhece o
// site sentiu falta do item — visitante novo sentiria mais. Voltou.
//
// E a vaga que eu tinha "aberto" nem era necessária: medido, sete itens cabem
// com folga (sobra 251px a 1440, 100px a 1180). O estouro que existia a 1024px
// acontecia com SEIS itens também — a causa era a largura da janela, não a
// quantidade de destinos. O hambúrguer resolve essa faixa.
const links = ([
  ["inicio", "nav.inicio"],
  ["historia", "nav.historia"],
  ["obra", "nav.obra"],
  ["personagens", "nav.personagens"],
  ["criadores", "nav.criadores"],
  ["loja", "nav.loja"],
  ["faq", "nav.faqCurto"],
] as const).map(([chave, rotulo]) => ({
  href: caminho(chave, idioma),
  texto: t(rotulo),
  raiz: chave === "inicio",
}));

const inicio = caminho("inicio", idioma);
const espera = `${inicio.replace(/\/$/, "")}/#lista-de-espera`;

const ativo = (href: string, raiz: boolean) => {
  const alvo = href.replace(/\/$/, "") || "/";
  return raiz ? atual === alvo : atual.startsWith(alvo);
};

// Um idioma só não é escolha: o seletor some enquanto EN e ES não existirem.
const idiomasLink = ATIVOS.length > 1 ? ATIVOS.map((outro) => ({
  ...IDIOMAS[outro],
  codigo: outro,
  href: equivalente(Astro.url.pathname, outro),
  atual: outro === idioma,
})) : [];
---

<header class="cabecalho">
  <div class="barra">
    <a class="marca" href={inicio} aria-label={t("nav.inicioAria")}>
      <span class="kanji" aria-hidden="true">向こう側</span>
      <span class="romaji">Mukō·Gawa</span>
    </a>

    <button
      class="hamburguer"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principal"
      aria-label={t("nav.abrirMenu")}
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>

    <nav id="menu-principal" class="menu" aria-label={t("nav.principal")}>
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={ativo(l.href, l.raiz) ? "page" : undefined}>
              {l.texto}
            </a>
          </li>
        ))}
      </ul>

      {idiomasLink.length > 0 && (
      <details class="idiomas">
        <summary>
          <span class="so-leitor">{t("cta.idioma")}</span>
          <span class="atual" aria-hidden="true">{IDIOMAS[idioma].curto}</span>
          <span class="seta" aria-hidden="true"></span>
        </summary>
        <ul>
          {idiomasLink.map((i) => (
            <li>
              <a
                href={i.href}
                hreflang={i.htmlLang}
                lang={i.htmlLang}
                aria-current={i.atual ? "true" : undefined}
              >{i.rotulo}</a>
            </li>
          ))}
        </ul>
      </details>
      )}

      <a class="cta" href={espera}>{t("cta.aviseMe")}</a>
    </nav>
  </div>
</header>

<style>
  .cabecalho {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    background: color-mix(in srgb, var(--tinta) 82%, transparent);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--linha);
  }

  .barra {
    max-width: var(--max);
    margin-inline: auto;
    padding: 0 var(--gutter);
    height: 76px;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .marca {
    display: flex;
    min-height: 44px;
    flex-direction: column;
    justify-content: center;
    text-decoration: none;
    margin-right: auto;
    line-height: 1;
  }
  .kanji {
    font-family: var(--fonte-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--osso);
    letter-spacing: .04em;
  }
  .romaji {
    font-family: var(--fonte-ui);
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .42em;
    text-transform: uppercase;
    color: var(--poeira);
    margin-top: 5px;
  }

  .menu {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.4vw, 40px);
  }
  .menu > ul {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 32px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu a {
    display: inline-flex;
    align-items: center;
    min-height: 46px;
    font-family: var(--fonte-ui);
    font-weight: 500;
    font-size: .92rem;
    letter-spacing: .2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--cinza);
    position: relative;
    white-space: nowrap;   /* "A obra" quebrava em "A" / "obra" a 1024px */
    transition: color .18s ease;
  }
  .menu a:hover { color: var(--osso); }
  .menu a[aria-current="page"] { color: var(--osso); }
  .menu a[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 10px;
    height: 2px;
    background: var(--sangue);
  }

  /* Seletor de idioma: três siglas, separadas por filete, mais discretas que
     os itens de navegação. Não é destino, é ajuste — então não compete. */
  /* Os três códigos lado a lado custavam 129px fixos do cabeçalho. Medido: a
     1100px a barra já estourava em 134px, e cada idioma novo piora. Agora é um
     menu que mostra só o idioma corrente e abre os outros.

     `<details>` de novo, e não um `<select>`: os itens continuam sendo <a> de
     verdade, então funcionam sem JavaScript, o hreflang segue apontando para
     páginas reais e o robô de busca continua enxergando os três caminhos. Um
     select precisaria de script para navegar e não deixaria link nenhum. */
  .menu .idiomas {
    position: relative;
    border-inline: 1px solid var(--linha-forte);
  }
  .menu .idiomas summary {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    padding: 0 13px;
    cursor: pointer;
    list-style: none;
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: .78rem;
    letter-spacing: .14em;
    color: var(--poeira);
    transition: color .2s ease;
  }
  .menu .idiomas summary::-webkit-details-marker { display: none; }
  .menu .idiomas summary:hover,
  .menu .idiomas[open] summary { color: var(--osso); }
  .menu .idiomas summary:focus-visible {
    outline: 2px solid var(--sangue-vivo);
    outline-offset: -2px;
  }
  .menu .idiomas .atual { position: relative; }
  .menu .idiomas .atual::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -7px;
    height: 2px;
    background: var(--sangue);
  }
  .menu .idiomas .seta {
    width: 7px; height: 7px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform .25s ease;
  }
  .menu .idiomas[open] .seta { transform: translateY(1px) rotate(-135deg); }

  .menu .idiomas ul {
    position: absolute;
    top: calc(100% + 1px);
    right: -1px;
    z-index: 10;
    min-width: 148px;
    margin: 0;
    padding: 6px 0;
    list-style: none;
    background: var(--tinta);
    border: 1px solid var(--linha-forte);
  }
  .menu .idiomas ul a {
    display: flex;
    align-items: center;
    min-height: 44px;      /* piso de alvo de toque — o auditor pega 42 */
    padding: 0 16px;
    font-family: var(--fonte-ui);
    font-size: .8rem;
    letter-spacing: .1em;
    text-transform: none;
    color: var(--poeira);
    white-space: nowrap;
  }
  .menu .idiomas ul a:hover { color: var(--osso); background: var(--tinta-2); }
  .menu .idiomas ul a[aria-current="true"] { color: var(--osso); }
  .menu .idiomas ul a[aria-current="true"]::before {
    content: "";
    width: 5px; height: 5px;
    margin-right: 9px;
    margin-left: -14px;
    background: var(--sangue);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    background: var(--sangue);
    color: #fff !important;
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: .85rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;   /* "AVISE-ME" quebrava em "AVISE-" / "ME" a 1024px */
    clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
    transition: background .18s ease;
  }
  .cta:hover { background: #ee2b35; }
  .cta::after { display: none !important; }

  /* ---------- hambúrguer ---------- */

  .hamburguer {
    display: none;
    width: 48px;
    height: 48px;
    padding: 0;
    background: none;
    border: 1px solid var(--linha-forte);
    cursor: pointer;
    position: relative;
  }
  .hamburguer span {
    position: absolute;
    left: 13px;
    width: 20px;
    height: 1.5px;
    background: var(--osso);
    transition: transform .26s cubic-bezier(.2,.8,.2,1), opacity .18s ease;
  }
  .hamburguer span:nth-child(1) { top: 17px; }
  .hamburguer span:nth-child(2) { top: 23px; }
  .hamburguer span:nth-child(3) { top: 29px; }
  .hamburguer[aria-expanded="true"] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .hamburguer[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .hamburguer[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  /* ---------- mobile ---------- */

  /* Ponto de virada do hambúrguer: era 920px e foi para 1180 em 2026-08-03,
     quando "A obra" entrou no menu e "Início" voltou. Varrido de 960 a 1200px
     nos três idiomas, com os SETE itens: a 1200 cabe em PT, EN e JA; a 1120
     estoura 28px em PT e 15px em EN. Daí o corte em 1180.

     Parece alto para um hambúrguer, e é de propósito: o hero já entra em layout
     empilhado abaixo de 1280, então nessa faixa a página inteira está em modo
     estreito. Um menu horizontal espremido sobre uma página empilhada seria a
     incoerência, não o hambúrguer. */
  @media (max-width: 1180px) {
    .hamburguer { display: block; order: 3; }

    .menu {
      position: fixed;
      inset: 76px 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--tinta);
      border-bottom: 1px solid var(--linha);
      padding: 8px var(--gutter) 28px;
      max-height: calc(100dvh - 76px);
      overflow-y: auto;
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition: opacity .2s ease, transform .2s ease, visibility .2s;
    }
    .menu[data-aberto="true"] {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    .menu > ul { flex-direction: column; align-items: stretch; gap: 0; }
    .menu li { border-bottom: 1px solid var(--linha); }
    .menu a {
      min-height: 58px;
      font-size: 1.05rem;
      width: 100%;
    }
    .menu a[aria-current="page"]::after { bottom: 16px; width: 22px; right: auto; }
    .cta { margin-top: 22px; justify-content: center; min-height: 54px; }

    /* No mobile o painel abre EM FLUXO, não flutuando.
       Medido a 375px com o menu aberto: herdando o `right: -1px` do desktop, o
       painel de 148px ficava ancorado pela direita de um seletor de 61,8px
       encostado na ESQUERDA da coluna, e começava em x = -66,2 — sessenta e seis
       pixels fora da tela, com "Português" e "English" decepados na borda. Somava
       a isso um corte de 37px embaixo, do `overflow-y: auto` do próprio menu.
       Mover a âncora resolveria o vazamento e não o corte, e o painel ainda
       cobriria o CTA. Em fluxo, ele empurra o que vem abaixo e o menu rola.

       O comentário anterior aqui defendia não empilhar os idiomas. Valia para o
       desenho antigo, em que as três siglas ficavam sempre visíveis: ali seriam
       destinos falsos numa lista de destinos. Com <details>, as opções só existem
       depois que a pessoa abre de propósito. */
    .menu .idiomas {
      align-self: stretch;
      margin-top: 22px;
      border: 1px solid var(--linha-forte);
    }
    /* `display: flex`, não o inline-flex do desktop: sem isso o summary encolhe
       para o tamanho do texto e o `space-between` não empurra a seta. */
    .menu .idiomas summary {
      display: flex;
      justify-content: space-between;
      min-height: 54px;
      padding: 0 18px;
      font-size: .85rem;
    }
    .menu .idiomas ul {
      position: static;
      min-width: 0;
      padding: 0;
      border: 0;
      border-top: 1px solid var(--linha);
      background: var(--tinta-2);
    }
    .menu .idiomas li { border-bottom: 0; }
    .menu .idiomas ul a {
      min-height: 54px;
      width: 100%;
      padding: 0 18px;
      font-size: .95rem;
    }
    .menu .idiomas ul a[aria-current="true"]::before { margin-left: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu, .hamburguer span { transition: none; }
  }
</style>

<script>
  const botao = document.querySelector<HTMLButtonElement>(".hamburguer");
  const menu = document.getElementById("menu-principal");

  if (botao && menu) {
    const definir = (aberto: boolean) => {
      botao.setAttribute("aria-expanded", String(aberto));
      botao.setAttribute("aria-label", aberto ? "Fechar menu" : "Abrir menu");
      menu.dataset.aberto = String(aberto);
      document.body.style.overflow = aberto ? "hidden" : "";
    };

    botao.addEventListener("click", () => {
      definir(botao.getAttribute("aria-expanded") !== "true");
    });

    menu.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) definir(false);
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && botao.getAttribute("aria-expanded") === "true") {
        definir(false);
        botao.focus();
      }
    });

    // Se a janela cresce além do breakpoint, o menu volta ao estado de desktop.
    const mq = window.matchMedia("(min-width: 1181px)");
    mq.addEventListener("change", (e) => { if (e.matches) definir(false); });
  }

  // O menu de idiomas é um <details>, então abre e fecha sozinho e funciona sem
  // isto aqui. O que falta ao elemento nativo é fechar quando se clica fora ou
  // se aperta Esc — sem isso ele fica aberto para trás enquanto a pessoa navega
  // a página. É só esse acabamento.
  const idiomas = document.querySelector<HTMLDetailsElement>(".idiomas");
  if (idiomas) {
    document.addEventListener("click", (e) => {
      if (idiomas.open && !idiomas.contains(e.target as Node)) idiomas.open = false;
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && idiomas.open) {
        idiomas.open = false;
        idiomas.querySelector("summary")?.focus();
      }
    });
  }
</script>
