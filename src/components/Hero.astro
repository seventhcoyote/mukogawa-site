---
import { INICIO } from "../i18n/conteudo/inicio";
import { idiomaDaUrl, rota } from "../i18n/idiomas";

import { Image } from "astro:assets";
import logo from "../assets/marca/logo-mukogawa.png";
import arte from "../assets/hero/hero.png";

// Houve aqui um vídeo de 6s em loop — um push-in que terminava com a aura
// acesa. Saiu por decisão do Bruno em 2026-08-02: fica só a arte parada.
//
// A arte é o PRIMEIRO quadro daquele vídeo, extraído em 1920×1080, e não o
// último. O quadro final fechava o enquadramento a ponto de decepar as pontas
// das asas nas laterais, e este projeto não corta asa. No primeiro quadro a
// figura está inteira.
//
// No desktop a altura do hero acompanha a proporção 16:9 da arte, então quase
// nada é cortado, e o que sobra sai da BASE (rocha e chão). No celular a arte
// fica em bloco próprio, 100% visível, e o texto vem abaixo.

const c = INICIO[idiomaDaUrl(Astro.url.pathname)];
const hrefHistoria = rota("historia", idiomaDaUrl(Astro.url.pathname));
---

<section class="hero">
  <div class="palco">
    <Image
      class="arte"
      src={arte}
      alt=""
      widths={[900, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <span class="halftone" aria-hidden="true"></span>
    <span class="veu" aria-hidden="true"></span>
  </div>

  <div class="envelope conteudo">
    <p class="rotulo">{c.heroRotulo}</p>

    <h1>
      <Image class="marca" src={logo} alt="Mukō-Gawa 向こう側" widths={[420, 760]} sizes="(max-width: 760px) 76vw, 40vw" loading="eager" fetchpriority="high" />
    </h1>

    <p class="sinopse">{c.heroLead}</p>

    <div class="acoes">
      <a class="botao" href="#lista-de-espera">{c.heroCta}</a>
      <a class="botao botao--fantasma" href={hrefHistoria}>{c.heroSecundario}</a>
    </div>
  </div>

  <a class="descer" href="#anuncio" aria-label={c.heroDescer}>
    <span aria-hidden="true"></span>
  </a>
</section>

<style>
  /* Imagem sangrando de lado a lado (cover) e o texto no topo.
     object-position 50% 0% ancora a arte pelo TOPO: quando a tela é mais
     larga que 16:9, o que sobra é descartado da BASE (rocha e chão), nunca
     da cabeça nem das asas. */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-start;
    min-height: max(620px, 100dvh);
    padding-top: 77px;              /* 76 do header + 1 da borda */
    background: var(--vazio);
    overflow: hidden;
  }

  .palco { position: absolute; inset: 77px 0 0 0; z-index: 0; }

  /* `:global` porque <Image> do Astro emite a <img> fora do escopo do estilo.

     `cover` com `50% 0%` é o enquadramento original e é o melhor: a figura fica
     à direita e a coluna do texto cai sobre céu, não sobre armadura. O que
     estava errado não era isto, era o alcance: abaixo de 1280 a arte escalava
     pela altura e invadia o texto (medido a 1024×900, 30% da largura fora da
     tela; a 1200, 19%). O layout empilhado agora começa a 1280 e cobre essa
     faixa, então aqui só entra janela larga, onde o corte lateral é de poucos
     por cento e sai de nuvem.
     No eixo vertical a arte é ancorada pelo TOPO, então a sobra sai da BASE
     (rocha e chão) e nunca da cabeça ou das asas. */
  .arte, .palco :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
  }

  .palco .halftone { color: #000; opacity: .12; z-index: 1; }

  /* A arte do hero é colorida: vermelho vivo. Quem apagava a cor era este véu,
     chapado sobre a imagem inteira. Ele existe por um motivo real — o texto
     branco precisa de contraste — mas só precisa disso do lado ESQUERDO, onde o
     texto está. À direita, onde só há arte, ele se abre e deixa a cor aparecer.
     O gradiente da esquerda continua forte o bastante para o texto: medido em
     16,4:1 no rótulo e 16,4:1 na sinopse, muito acima do piso de AA. */
  .veu {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(90deg,
        color-mix(in srgb, var(--vazio) 90%, transparent) 0%,
        color-mix(in srgb, var(--vazio) 62%, transparent) 30%,
        color-mix(in srgb, var(--vazio) 18%, transparent) 52%,
        transparent 68%),
      linear-gradient(180deg, color-mix(in srgb, var(--vazio) 52%, transparent) 0%, transparent 24%),
      linear-gradient(0deg, var(--vazio) 0%, transparent 20%);
  }

  .conteudo {
    position: relative;
    z-index: 3;
    width: 100%;
    padding-top: clamp(26px, 5vh, 58px);
  }

  /* tudo um degrau acima: o hero é o único lugar onde o texto compete com
     a arte, então ele precisa de mais corpo para se ler de primeira. */
  .rotulo {
    color: var(--osso);
    font-size: clamp(.86rem, 1.05vw, 1rem);
    letter-spacing: .3em;
    margin-bottom: 24px;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 1);
  }

  h1 { margin: 0 0 26px; line-height: 0; }
  .marca {
    width: min(38vw, 480px);
    height: auto;
    filter: drop-shadow(0 0 40px rgba(0, 0, 0, .95));
  }

  .sinopse {
    max-width: 46ch;
    font-size: clamp(1.1rem, 1.5vw, 1.34rem);
    line-height: 1.62;
    color: var(--osso);
    margin-bottom: 34px;
    text-shadow: 0 2px 22px rgba(0, 0, 0, 1);
  }

  .acoes { display: flex; flex-wrap: wrap; gap: 16px; }
  .acoes :global(.botao) {
    min-height: 60px;
    padding-inline: 38px;
    font-size: 1.04rem;
    letter-spacing: .22em;
  }

  .descer { display: none; }

  @media (max-height: 800px) and (min-width: 1281px) {
    .marca { width: min(30vw, 380px); }
    .sinopse { font-size: 1.05rem; margin-bottom: 24px; max-width: 42ch; }
    .rotulo { margin-bottom: 16px; }
    h1 { margin-bottom: 20px; }
    .acoes :global(.botao) { min-height: 54px; padding-inline: 30px; font-size: .98rem; }
  }

  /* Arte em bloco próprio, texto abaixo. O ponto de virada era 860px e subiu
     para 1100 em 2026-08-02: entre 860 e 1100 a janela é estreita demais para o
     layout sobreposto. Medido a 1024×900, a arte escalava pela altura, entrava
     823px de altura por 1464 de largura, e a figura invadia a coluna do texto —
     o botão secundário caía em cima da armadura. Empilhado, a arte aparece
     inteira e o texto tem fundo limpo.

     Subiu de novo para 1280 depois de medir: a 1200 a asa esquerda ainda passava
     por baixo do botão secundário. A partir de 1280 sobra folga de verdade. */
  @media (max-width: 1280px) {
    .hero {
      display: block;
      min-height: 0;
      overflow: visible;
      padding-bottom: clamp(40px, 7vh, 64px);
    }
    .palco { position: relative; inset: auto; aspect-ratio: 16 / 9; }
    .arte, .palco :global(img) { object-fit: contain; object-position: 50% 50%; }
    .veu { background: linear-gradient(0deg, var(--vazio) 0%, transparent 30%); }
    .conteudo { margin-top: clamp(20px, 5vw, 36px); padding-top: 0; }
    .marca { width: min(80vw, 440px); }
    .sinopse { font-size: 1.08rem; max-width: none; }
    .acoes :global(.botao) { width: 100%; min-height: 56px; }
  }
</style>
