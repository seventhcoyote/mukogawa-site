---
import { INICIO } from "../i18n/conteudo/inicio";
import { idiomaDaUrl, rota } from "../i18n/idiomas";

import { Image } from "astro:assets";
import logo from "../assets/marca/logo-mukogawa.png";
import arte from "../assets/hero/hero.png";

// Houve aqui um vídeo de 6s em loop — um push-in que terminava com a aura
// acesa. Saiu por decisão do Bruno em 2026-08-02: fica só a arte parada.
//
// A arte é o PRIMEIRO quadro daquele vídeo, extraído em 1920×1080, e não o
// último. O quadro final fechava o enquadramento a ponto de decepar as pontas
// das asas nas laterais, e este projeto não corta asa. No primeiro quadro a
// figura está inteira.
//
// No desktop a altura do hero acompanha a proporção 16:9 da arte, então quase
// nada é cortado, e o que sobra sai da BASE (rocha e chão). No celular a arte
// fica em bloco próprio, 100% visível, e o texto vem abaixo.

const c = INICIO[idiomaDaUrl(Astro.url.pathname)];
const hrefHistoria = rota("historia", idiomaDaUrl(Astro.url.pathname));
---

<section class="hero">
  <div class="palco">
    <Image
      class="arte"
      src={arte}
      alt=""
      widths={[900, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <span class="halftone" aria-hidden="true"></span>
    <span class="veu" aria-hidden="true"></span>
  </div>

  <div class="envelope conteudo">
    <p class="rotulo">{c.heroRotulo}</p>

    <h1>
      <Image class="marca" src={logo} alt="Mukō-Gawa 向こう側" widths={[420, 760]} sizes="(max-width: 760px) 76vw, 40vw" loading="eager" fetchpriority="high" />
    </h1>

    <p class="sinopse">{c.heroLead}</p>

    <div class="acoes">
      <a class="botao" href="#lista-de-espera">{c.heroCta}</a>
      <a class="botao botao--fantasma" href={hrefHistoria}>{c.heroSecundario}</a>
    </div>
  </div>

  <a class="descer" href="#anuncio" aria-label={c.heroDescer}>
    <span aria-hidden="true"></span>
  </a>
</section>

<style>
  /* Imagem sangrando de lado a lado (cover) e o texto no topo.
     object-position 50% 0% ancora a arte pelo TOPO: quando a tela é mais
     larga que 16:9, o que sobra é descartado da BASE (rocha e chão), nunca
     da cabeça nem das asas. */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-start;
    min-height: max(620px, 100dvh);
    padding-top: 77px;              /* 76 do header + 1 da borda */
    background: var(--vazio);
    overflow: hidden;
  }

  /* O PALCO TRAVA E CENTRALIZA EM TELA LARGA.
     Ele é absoluto colado nas bordas da JANELA, e a arte dentro dele usa
     `margin-left: auto` para encostar à direita. Em tela comum isso funciona,
     porque o conteúdo ocupa quase toda a largura. Numa ultrawide, não: medido a
     3440px, o conteúdo terminava em 2400 e a arte ia até 3440 — a figura
     flutuava a mil pixels do texto, sozinha no vazio. O desvio do centro crescia
     com a tela: 158px a 1440, 530px a 2560, 970px a 3440.

     `max-width` + `margin-inline: auto` num elemento absoluto com `left` e
     `right` definidos centraliza sem `transform` — e transform aqui está fora de
     cogitação, porque cria contexto de empilhamento, que é o que já matou o
     blend quatro vezes neste projeto.

     1800px e não 1360px (a largura do conteúdo) de propósito: a arte deve passar
     um pouco além da coluna de texto, senão perde a sensação de sangria que o
     hero tem. Abaixo de 1800 nada muda — o comportamento aprovado em 1440 e
     1920 fica intacto. */
  .palco {
    position: absolute;
    inset: 77px 0 0 0;
    z-index: 0;
    max-width: 1800px;
    margin-inline: auto;
  }

  /* `:global` porque <Image> do Astro emite a <img> fora do escopo do estilo.

     A arte NÃO ocupa a largura toda: fica em ~78%, encostada à direita. Antes
     ela sangrava de lado a lado com `cover`, e isso custava duas coisas.
     Primeiro, `cover` escala pela dimensão limitante e joga o resto fora, então
     nunca se via a arte inteira. Segundo, e pior: a asa esquerda alcançava a
     coluna do texto, e o botão secundário caía em cima dela — medido, 25,4% dos
     pixels atrás de "Ler a história" eram claros, com o texto branco sumindo no
     branco da pena.

     Encolhendo e ancorando à direita, os dois se resolvem de uma vez: a figura
     aparece inteira (é o zoom out) e a coluna do texto passa a cair sobre fundo
     limpo. `contain` garante que nada seja cortado em nenhuma largura. */
  /* `aspect-ratio` em vez de `height: 100%`: com a caixa mais alta que a arte, o
     `contain` deixava faixa vazia dentro do próprio elemento, e a máscara — que
     se aplica à CAIXA, não ao que o object-fit desenhou nela — desbotava esse
     vazio em vez da arte. A borda dura na base sobrevivia. Com a caixa na
     proporção exata da arte, os dois coincidem. */
  .arte, .palco :global(img) {
    width: min(78%, 1500px);
    height: auto;
    aspect-ratio: 16 / 9;
    margin-left: auto;
    object-fit: contain;
    /* Duas máscaras cruzadas. Sem elas a arte encostada à direita ganha DUAS
       arestas duras contra o preto — uma vertical à esquerda e uma horizontal na
       base — e vira o retângulo colado que este projeto recusa. A da esquerda
       dissolve a entrada da arte; a de baixo dissolve a rocha, que é clara.
       `intersect` porque as duas precisam valer ao mesmo tempo: sobrepostas sem
       compor, a segunda simplesmente anularia a primeira.
       Sem z-index nem filter de propósito — os dois criam contexto de
       empilhamento, e isso já matou blend quatro vezes neste projeto. */
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, #000 18%),
      linear-gradient(to bottom, #000 82%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0%, #000 18%),
      linear-gradient(to bottom, #000 82%, transparent 100%);
    mask-composite: intersect;
  }

  /* A BORDA DIREITA SÓ EXISTE DEPOIS QUE O PALCO TRAVA.
     Enquanto o palco ia até a borda da janela, a direita da arte ficava fora da
     tela e não havia aresta para dissolver — por isso a máscara original só
     cuidava da esquerda e da base. Com o palco preso em 1800px, essa borda passa
     a cair DENTRO da tela, e a arte vira o retângulo colado que este projeto
     recusa em toda parte.

     A máscara ganha a ponta direita apenas acima de 1800px, onde o problema
     nasce: abaixo disso a arte continua sangrando na borda da janela, exatamente
     como foi aprovado. Um gradiente horizontal com as duas pontas transparentes
     resolve sem precisar de uma terceira camada de máscara. */
  @media (min-width: 1801px) {
    .arte, .palco :global(img) {
      -webkit-mask-image:
        linear-gradient(to right, transparent 0%, #000 16%, #000 86%, transparent 100%),
        linear-gradient(to bottom, #000 82%, transparent 100%);
      mask-image:
        linear-gradient(to right, transparent 0%, #000 16%, #000 86%, transparent 100%),
        linear-gradient(to bottom, #000 82%, transparent 100%);
    }
  }

  .palco .halftone { color: #000; opacity: .12; z-index: 1; }

  /* A arte do hero é colorida: vermelho vivo. Quem apagava a cor era este véu,
     chapado sobre a imagem inteira. Ele existe por um motivo real — o texto
     branco precisa de contraste — mas só precisa disso do lado ESQUERDO, onde o
     texto está. À direita, onde só há arte, ele se abre e deixa a cor aparecer.
     O gradiente da esquerda continua forte o bastante para o texto: medido em
     16,4:1 no rótulo e 16,4:1 na sinopse, muito acima do piso de AA. */
  .veu {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(90deg,
        color-mix(in srgb, var(--vazio) 90%, transparent) 0%,
        color-mix(in srgb, var(--vazio) 62%, transparent) 30%,
        color-mix(in srgb, var(--vazio) 18%, transparent) 52%,
        transparent 68%),
      linear-gradient(180deg, color-mix(in srgb, var(--vazio) 52%, transparent) 0%, transparent 24%),
      linear-gradient(0deg, var(--vazio) 0%, transparent 20%);
  }

  .conteudo {
    position: relative;
    z-index: 3;
    width: 100%;
    padding-top: clamp(26px, 5vh, 58px);
  }

  /* tudo um degrau acima: o hero é o único lugar onde o texto compete com
     a arte, então ele precisa de mais corpo para se ler de primeira. */
  .rotulo {
    color: var(--osso);
    font-size: clamp(.86rem, 1.05vw, 1rem);
    letter-spacing: .3em;
    margin-bottom: 24px;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 1);
  }

  h1 { margin: 0 0 26px; line-height: 0; }
  .marca {
    width: min(38vw, 480px);
    height: auto;
    filter: drop-shadow(0 0 40px rgba(0, 0, 0, .95));
  }

  .sinopse {
    max-width: 46ch;
    font-size: clamp(1.1rem, 1.5vw, 1.34rem);
    line-height: 1.62;
    color: var(--osso);
    margin-bottom: 34px;
    text-shadow: 0 2px 22px rgba(0, 0, 0, 1);
  }

  .acoes { display: flex; flex-wrap: wrap; gap: 16px; }
  .acoes :global(.botao) {
    min-height: 60px;
    padding-inline: 38px;
    font-size: 1.04rem;
    letter-spacing: .22em;
  }

  /* O botão secundário é o único elemento do site que fica SOBRE a arte com
     fundo transparente, e a arte tem nuvem branca e rocha clara justamente na
     altura dele: medido, até 38,9% dos pixels atrás dele são claros, e o texto
     branco sumia no branco da pena. Ganha fundo próprio, pelo mesmo motivo que
     a tarja da data tem fundo na imagem de compartilhamento — é informação e
     precisa ser legível, não pode depender do que estiver por baixo.
     Cor sólida e não `backdrop-filter`: o filtro criaria contexto de
     empilhamento, e isso já quebrou blend quatro vezes neste projeto. */
  .acoes :global(.botao--fantasma) {
    background: color-mix(in srgb, var(--vazio) 82%, transparent);
    border-color: color-mix(in srgb, var(--osso) 46%, transparent);
  }
  .acoes :global(.botao--fantasma:hover) {
    background: color-mix(in srgb, var(--vazio) 92%, transparent);
    border-color: var(--osso);
  }

  .descer { display: none; }

  @media (max-height: 800px) and (min-width: 1281px) {
    .marca { width: min(30vw, 380px); }
    .sinopse { font-size: 1.05rem; margin-bottom: 24px; max-width: 42ch; }
    .rotulo { margin-bottom: 16px; }
    h1 { margin-bottom: 20px; }
    .acoes :global(.botao) { min-height: 54px; padding-inline: 30px; font-size: .98rem; }
  }

  /* Arte em bloco próprio, texto abaixo. O ponto de virada era 860px e subiu
     para 1100 em 2026-08-02: entre 860 e 1100 a janela é estreita demais para o
     layout sobreposto. Medido a 1024×900, a arte escalava pela altura, entrava
     823px de altura por 1464 de largura, e a figura invadia a coluna do texto —
     o botão secundário caía em cima da armadura. Empilhado, a arte aparece
     inteira e o texto tem fundo limpo.

     Subiu de novo para 1280 depois de medir: a 1200 a asa esquerda ainda passava
     por baixo do botão secundário. A partir de 1280 sobra folga de verdade. */
  @media (max-width: 1280px) {
    .hero {
      display: block;
      min-height: 0;
      overflow: visible;
      padding-bottom: clamp(40px, 7vh, 64px);
    }
    .palco { position: relative; inset: auto; aspect-ratio: 16 / 9; }

    /* Aqui a arte volta a ocupar a LARGURA TODA, sem margem e sem máscara.
       O recuo de 78% à direita existe no desktop para tirar a figura de cima da
       coluna de texto — e no empilhado não há coluna de texto ao lado, o texto
       vem abaixo. Mantê-lo aqui só produzia defeito: medido a 375px, a arte
       ficava com 293px e sobravam 83px de faixa preta à esquerda, com a máscara
       desbotando a entrada por cima. Era o "borrão preto no canto esquerdo".
       Como o palco e a arte têm a mesma proporção 16/9, ela preenche exato e
       não sobra aresta para dissolver. */
    .arte, .palco :global(img) {
      width: 100%;
      margin-left: 0;
      object-fit: contain;
      object-position: 50% 50%;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .veu { background: linear-gradient(0deg, var(--vazio) 0%, transparent 30%); }
    .conteudo { margin-top: clamp(20px, 5vw, 36px); padding-top: 0; }
    .marca { width: min(80vw, 440px); }
    .sinopse { font-size: 1.08rem; max-width: none; }
    .acoes :global(.botao) { width: 100%; min-height: 56px; }
  }
</style>
