---
import { INICIO } from "../i18n/conteudo/inicio";
import { idiomaDaUrl, rota } from "../i18n/idiomas";

import { Image } from "astro:assets";
import logo from "../assets/marca/logo-mukogawa.png";

// O vídeo é um push-in que termina no instante em que a aura acende, cortado
// em 3,6s: depois disso o enquadramento fecha demais e come a cabeça e as asas.
// Ele roda uma vez e congela nesse quadro.
//
// No desktop a altura do hero acompanha a proporção 16:9 do vídeo, então quase
// nada é cortado. No celular o vídeo fica em bloco próprio, com a arte 100%
// visível, e o texto vem abaixo.

const c = INICIO[idiomaDaUrl(Astro.url.pathname)];
const hrefHistoria = rota("historia", idiomaDaUrl(Astro.url.pathname));
---

<section class="hero">
  <div class="palco">
    <video
      class="filme"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      disablepictureinpicture
      controlslist="nodownload nofullscreen noremoteplayback"
      poster="/video/poster.jpg"
      aria-hidden="true"
      tabindex="-1"
    >
      <source src="/video/hero-1080.mp4" type="video/mp4" media="(min-width: 900px)" />
      <source src="/video/hero-720.mp4" type="video/mp4" />
    </video>
    <span class="halftone" aria-hidden="true"></span>
    <span class="veu" aria-hidden="true"></span>
  </div>

  <div class="envelope conteudo">
    <p class="rotulo">{c.heroRotulo}</p>

    <h1>
      <Image class="marca" src={logo} alt="Mukō-Gawa 向こう側" widths={[420, 760]} sizes="(max-width: 760px) 76vw, 40vw" loading="eager" fetchpriority="high" />
    </h1>

    <p class="sinopse">{c.heroLead}</p>

    <div class="acoes">
      <a class="botao" href="#lista-de-espera">{c.heroCta}</a>
      <a class="botao botao--fantasma" href={hrefHistoria}>{c.heroSecundario}</a>
    </div>
  </div>

  <a class="descer" href="#anuncio" aria-label={c.heroDescer}>
    <span aria-hidden="true"></span>
  </a>
</section>

<style>
  /* Imagem sangrando de lado a lado (cover) e o texto no topo.
     object-position 50% 0% ancora o vídeo pelo TOPO: quando a tela é mais
     larga que 16:9, o que sobra é descartado da BASE (rocha e chão), nunca
     da cabeça nem das asas. */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-start;
    min-height: max(620px, 100dvh);
    padding-top: 77px;              /* 76 do header + 1 da borda */
    background: var(--vazio);
    overflow: hidden;
  }

  .palco { position: absolute; inset: 77px 0 0 0; z-index: 0; }

  .filme {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
  }

  .palco .halftone { color: #000; opacity: .12; z-index: 1; }

  /* O vídeo do hero SEMPRE foi colorido: vermelho vivo e aura dourada. Quem
     apagava a cor era este véu, chapado sobre a imagem inteira. Ele existe por
     um motivo real — o texto branco precisa de contraste — mas só precisa
     disso do lado ESQUERDO, onde o texto está. À direita, onde só há arte, ele
     agora se abre e deixa a cor aparecer.
     O gradiente da esquerda continua forte o bastante para o texto: medido em
     16,4:1 no rótulo e 16,4:1 na sinopse, muito acima do piso de AA. */
  .veu {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(90deg,
        color-mix(in srgb, var(--vazio) 90%, transparent) 0%,
        color-mix(in srgb, var(--vazio) 62%, transparent) 30%,
        color-mix(in srgb, var(--vazio) 18%, transparent) 52%,
        transparent 68%),
      linear-gradient(180deg, color-mix(in srgb, var(--vazio) 52%, transparent) 0%, transparent 24%),
      linear-gradient(0deg, var(--vazio) 0%, transparent 20%);
  }

  .conteudo {
    position: relative;
    z-index: 3;
    width: 100%;
    padding-top: clamp(26px, 5vh, 58px);
  }

  /* tudo um degrau acima: o hero é o único lugar onde o texto compete com
     a arte, então ele precisa de mais corpo para se ler de primeira. */
  .rotulo {
    color: var(--osso);
    font-size: clamp(.86rem, 1.05vw, 1rem);
    letter-spacing: .3em;
    margin-bottom: 24px;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 1);
  }

  h1 { margin: 0 0 26px; line-height: 0; }
  .marca {
    width: min(38vw, 480px);
    height: auto;
    filter: drop-shadow(0 0 40px rgba(0, 0, 0, .95));
  }

  .sinopse {
    max-width: 46ch;
    font-size: clamp(1.1rem, 1.5vw, 1.34rem);
    line-height: 1.62;
    color: var(--osso);
    margin-bottom: 34px;
    text-shadow: 0 2px 22px rgba(0, 0, 0, 1);
  }

  .acoes { display: flex; flex-wrap: wrap; gap: 16px; }
  .acoes :global(.botao) {
    min-height: 60px;
    padding-inline: 38px;
    font-size: 1.04rem;
    letter-spacing: .22em;
  }

  .descer { display: none; }

  @media (max-height: 800px) and (min-width: 861px) {
    .marca { width: min(30vw, 380px); }
    .sinopse { font-size: 1.05rem; margin-bottom: 24px; max-width: 42ch; }
    .rotulo { margin-bottom: 16px; }
    h1 { margin-bottom: 20px; }
    .acoes :global(.botao) { min-height: 54px; padding-inline: 30px; font-size: .98rem; }
  }

  /* celular: vídeo inteiro em cima (sem corte lateral), texto embaixo */
  @media (max-width: 860px) {
    .hero {
      display: block;
      min-height: 0;
      overflow: visible;
      padding-bottom: clamp(40px, 7vh, 64px);
    }
    .palco { position: relative; inset: auto; aspect-ratio: 16 / 9; }
    .filme { object-fit: contain; object-position: 50% 50%; }
    .veu { background: linear-gradient(0deg, var(--vazio) 0%, transparent 30%); }
    .conteudo { margin-top: clamp(20px, 5vw, 36px); padding-top: 0; }
    .marca { width: min(80vw, 440px); }
    .sinopse { font-size: 1.08rem; max-width: none; }
    .acoes :global(.botao) { width: 100%; min-height: 56px; }
  }
</style>

<script>
  // O filme rodava uma vez e congelava no último quadro. Agora repete sem fim,
  // por `loop` no próprio elemento — sem JavaScript, porque `ended` não dispara
  // em vídeo com loop e um recomeço feito na mão engasgaria a emenda.
  //
  // Quem pede menos movimento continua recebendo um quadro parado.
  const video = document.querySelector<HTMLVideoElement>(".hero .filme");
  if (video) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      video.removeAttribute("autoplay");
      video.removeAttribute("loop");
      video.poster = "/video/poster-fim.jpg";
      video.pause();
    } else {
      video.play().catch(() => { video.poster = "/video/poster-fim.jpg"; });
    }
  }
</script>
