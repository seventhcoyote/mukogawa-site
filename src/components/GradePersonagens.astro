---
import CardPersonagem from "./CardPersonagem.astro";
import type { Personagem } from "../data/personagens";

interface Props {
  lista: Personagem[];
  prioridadeAte?: number;
}
const { lista, prioridadeAte = 4 } = Astro.props;
---

<div class="grade">
  {lista.map((p, i) => <CardPersonagem p={p} prioridade={i < prioridadeAte} />)}
</div>

<style>
  .grade {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: clamp(18px, 2.4vw, 34px);
  }

  /* Quando um personagem acende, o resto recua. */
  .grade:has(:global(.card:is(:hover, :focus-visible)))
    :global(.card:not(:hover):not(:focus-visible)) {
    opacity: .32;
    filter: saturate(0) brightness(.8);
  }

  @media (max-width: 520px) {
    .grade { grid-template-columns: repeat(2, 1fr); gap: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .grade:has(:global(.card:is(:hover, :focus-visible)))
      :global(.card:not(:hover):not(:focus-visible)) {
      opacity: .55;
      filter: none;
    }
  }
</style>
