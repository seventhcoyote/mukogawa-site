---
/**
 * Página de endereço inexistente.
 *
 * É uma só, em português, porque o site é estático: a Vercel serve este mesmo
 * arquivo para qualquer caminho perdido, e nesse momento não há como saber o
 * idioma pretendido. Por isso ela oferece a saída nos dois idiomas ativos em
 * vez de presumir um.
 *
 * Importa mais do que parece: mukogawa.com ainda serve o site antigo, e quando
 * a migração acontecer todo link antigo em circulação vai cair aqui.
 *
 * Voz da casa, seca (ver conteudo/VOZ.md). Nada de "perdeste teu caminho": o
 * épico é do mundo, não da interface.
 */
import Base from "../layouts/Base.astro";
import { usarUI } from "../i18n/ui";
import { ATIVOS, IDIOMAS, rota } from "../i18n/idiomas";

const t = usarUI("pt");

const destinos = (["inicio", "bleedingLight", "criadores", "loja"] as const).map((chave) => ({
  texto: t(`nav.${chave}` as const),
  href: rota(chave, "pt"),
}));
---

<Base titulo={t("404.titulo")} descricao={t("404.texto")}>
  <section class="secao secao--curta">
    <span class="selo-fundo" aria-hidden="true">迷</span>

    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">{t("404.rotulo")}</p></div>
        <h1>{t("404.titulo")}</h1>
        <p class="lead">{t("404.texto")}</p>
      </div>

      <a class="botao" href={rota("inicio", "pt")}>{t("404.voltar")}</a>

      <nav class="destinos" aria-label={t("nav.principal")}>
        {destinos.map((d) => <a href={d.href}>{d.texto}</a>)}
      </nav>

      {ATIVOS.filter((i) => i !== "pt").length > 0 && (
        <p class="outro-idioma">
          {ATIVOS.filter((i) => i !== "pt").map((i) => (
            <a href={rota("inicio", i)} lang={IDIOMAS[i].htmlLang}>{IDIOMAS[i].rotulo}</a>
          ))}
        </p>
      )}
    </div>
  </section>
</Base>

<style>
  .secao { position: relative; overflow: hidden; }

  /* O mesmo recurso das outras aberturas: um kanji enorme e quase apagado ao
     fundo. 迷 é "extraviar-se". */
  .selo-fundo {
    position: absolute;
    right: -4%; top: 50%;
    transform: translateY(-50%);
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(12rem, 30vw, 26rem);
    line-height: 1;
    color: #fff;
    opacity: .03;
    user-select: none;
    pointer-events: none;
  }

  .envelope { position: relative; }

  .destinos {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: clamp(30px, 4vw, 44px);
    padding-top: clamp(24px, 3vw, 32px);
    border-top: 1px solid var(--linha);
  }
  .destinos a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;          /* alvo de toque */
    font-family: var(--fonte-ui);
    font-size: .82rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--poeira);
    text-decoration: none;
    transition: color .2s ease;
  }
  .destinos a:hover { color: var(--osso); }

  .outro-idioma { margin: 18px 0 0; }
  .outro-idioma a {
    font-family: var(--fonte-ui);
    font-size: .82rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--poeira);
  }
</style>
