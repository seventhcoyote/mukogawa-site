---
import Base from "../../layouts/Base.astro";
import GradePersonagens from "../../components/GradePersonagens.astro";
import { personagens, CLASSES } from "../../data/personagens";

const porClasse = CLASSES.map((c) => ({
  ...c,
  membros: personagens.filter((p) => p.classeNum === c.num),
})).filter((c) => c.membros.length > 0);
---

<Base
  titulo="Personagens"
  descricao="As nove classes da Hoste e os Eternos que as encarnam. Gabriel, Miguel, Helel, Satis e o restante do elenco de Mukō-Gawa."
>
  <section class="secao secao--curta">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">O elenco</p></div>
        <h1>Personagens</h1>
        <p class="lead">
          O elenco é vasto. Estas páginas apresentam as nove classes, uma por vez.
        </p>
      </div>

      <nav class="indice" aria-label="Índice por classe">
        {porClasse.map((c) => (
          <a href={`#classe-${c.num}`}>
            <span class="kanji" aria-hidden="true">{c.kanji}</span>
            <span class="num">{c.num}</span>
            <span class="nome">{c.nome}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="secao secao--curta">
    <div class="envelope">
      <GradePersonagens lista={personagens} prioridadeAte={6} />
    </div>
  </section>

  <hr class="regua" />

  <section class="secao secao--curta">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">Por classe</p></div>
        <h2>As Nove Classes</h2>
      </div>

      <div class="classes">
        {porClasse.map((c) => (
          <article class="classe" id={`classe-${c.num}`}>
            <header>
              <p class="rotulo">Classe {c.num}</p>
              <h3>
                <span class="selo" aria-hidden="true">{c.kanji}</span>
                {c.nome}
              </h3>
            </header>

            <ul>
              {c.membros.map((p) => (
                <li data-lado={p.lado}>
                  <a href={`/personagens/${p.slug}`}>
                    <span class="ponto" aria-hidden="true"></span>
                    <span class="dados">
                      <span class="nome">{p.nome}</span>
                      <span class="baixo">
                        <span class="epiteto">{p.epiteto}</span>
                        <span class="lado">{p.lado === "hoste" ? "Hoste" : "Rebeldes"}</span>
                      </span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  h1 { font-size: clamp(2.4rem, 6vw, 4.6rem); }

  /* 3x3 fixo: nove classes fecham a grade sem sobrar bloco gigante. */
  .indice {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--linha);
    border: 1px solid var(--linha);
  }
  .indice a {
    position: relative;
    display: grid;
    gap: 4px;
    padding: 18px 18px 16px;
    background: var(--tinta);
    text-decoration: none;
    overflow: hidden;
    transition: background .25s ease;
  }
  .indice a:hover { background: var(--tinta-2); }
  .indice .kanji {
    position: absolute;
    right: -4px; bottom: -16px;
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: 3.6rem;
    color: #fff;
    opacity: .05;
  }
  .indice .num {
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: .68rem;
    letter-spacing: .3em;
    color: var(--sangue-vivo);
  }
  .indice .nome {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(.92rem, 1.5vw, 1.05rem);
    color: var(--osso);
  }
  @media (max-width: 620px) {
    .indice a { padding: 14px 10px 12px; }
    .indice .kanji { font-size: 2.8rem; }
  }

  /* Duas classes por linha, e o lado (Hoste/Rebeldes) colado no nome em vez
     de jogado na outra ponta da tela — era isso que abria o vazio enorme. */
  .classes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--linha);
    border: 1px solid var(--linha);
  }

  .classe {
    background: var(--tinta);
    padding: clamp(20px, 2.2vw, 30px);
    scroll-margin-top: 100px;      /* o header fixo não cobre a âncora */
  }
  /* nove é ímpar: o último ocupa a linha toda em vez de deixar célula vazia */
  .classe:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .classe header { margin-bottom: 16px; }
  .classe .rotulo { font-size: .68rem; letter-spacing: .3em; margin-bottom: 8px; }
  .classe h3 {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
  }
  .classe h3 .selo { font-size: .8em; color: var(--poeira); font-weight: 600; }

  .classe ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .classe li { background: var(--tinta-2); }
  .classe li a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    text-decoration: none;
    transition: background .2s ease;
  }
  .classe li a:hover { background: color-mix(in srgb, var(--lado) 12%, var(--tinta-2)); }

  .classe .ponto { width: 7px; height: 7px; flex: none; background: var(--lado); }
  .classe .dados { display: grid; gap: 3px; min-width: 0; }
  .classe .nome {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.15;
    color: var(--osso);
  }
  .classe .baixo {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--fonte-ui);
    font-size: .76rem;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .classe .epiteto { color: var(--poeira); }
  .classe .lado {
    color: var(--lado);
    font-weight: 600;
    padding-left: 8px;
    border-left: 1px solid var(--linha-forte);
  }

  @media (max-width: 720px) {
    .classes { grid-template-columns: 1fr; }
  }
</style>
