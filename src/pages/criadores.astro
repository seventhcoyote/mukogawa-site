---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import israel from "../assets/criadores/israel-subira.jpg";
import bretas from "../assets/criadores/daniel-bretas.jpg";
import match from "../assets/criadores/guilherme-match.jpg";

// Página renomeada de "Autor" para "Criadores": o autor é um só, mas a obra
// tem três nomes. Papel explícito no lugar da hierarquia autor/artistas.
const equipe = [
  {
    nome: "Israel Subira",
    papel: "Criação e roteiro",
    img: israel,
    principal: true,
    instagram: { rotulo: "@israelsubira", href: "https://www.instagram.com/israelsubira/" },
    paragrafos: [
      "Israel Subira é o escritor e criador de Mukō-Gawa, com formação em teologia e trajetória na fantasia. Começou o projeto há cerca de sete anos, e desde então ele cresceu para um mangá, um ciclo de livros concluído e a base para uma adaptação animada, com forte presença nas redes sociais e grande expectativa em torno dele.",
      "Seu tempo como mestre de jogo em RPGs de mesa influenciou profundamente o projeto — suas próprias campanhas autorais foram o campo de treino antes de entrar na fantasia como escritor. A metodologia de Israel é híbrida, entre roteiro e exploração: planeja de antemão os pontos narrativos mais críticos, mas deixa espaço para um elenco forte conduzir a história e crescer junto com o arco principal.",
      "É apaixonado por arte e literatura, e tem também outras obras ainda inéditas em desenvolvimento.",
    ],
  },
  {
    nome: "Daniel Bretas",
    papel: "Arte conceitual",
    img: bretas,
    principal: false,
    instagram: { rotulo: "@calaboca.co", href: "https://www.instagram.com/calaboca.co" },
    paragrafos: [
      "Bretas desenhou a primeira leva de concept art original de Mukō-Gawa — os estudos de personagem e os designs das classes que definiram a linguagem visual da série.",
      "Venceu o Brasil Manga Awards em 2015 e, em 2023, levou dois prêmios no 35º Troféu HQ Mix: melhor produção para outras linguagens, por Calaboca e Escuta, e melhor projeto gráfico, por Colorbar.",
    ],
  },
  {
    nome: "Guilherme Match",
    papel: "Arte do mangá",
    img: match,
    principal: false,
    instagram: { rotulo: "@yohke", href: "https://www.instagram.com/yohke" },
    paragrafos: [
      "Guilherme Match tem longa trajetória na ilustração, boa parte dela na publicidade, mas foi nos quadrinhos que encontrou sua verdadeira paixão. Seu trabalho já foi publicado pela JBC, incluindo Kophee e sua HQ mais recente, Soundtrack.",
    ],
  },
];

const principal = equipe.find((e) => e.principal)!;
const artistas = equipe.filter((e) => !e.principal);
---

<Base
  titulo="Criadores"
  descricao="Israel Subira, criador e roteirista de Mukō-Gawa, com a arte conceitual de Daniel Bretas e a arte do mangá de Guilherme Match."
>
  <section class="secao secao--curta">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">Quem faz</p></div>
        <h1>Criadores</h1>
      </div>
    </div>
  </section>

  <section class="secao secao--curta">
    <div class="envelope destaque">
      <div class="retrato">
        <Image src={principal.img} alt={principal.nome} widths={[380, 700]} sizes="(max-width: 880px) 70vw, 34vw" loading="eager" />
        <span class="cantos" aria-hidden="true"></span>
      </div>
      <div class="texto">
        <p class="rotulo rotulo--lado" data-lado="rebeldes">{principal.papel} // Criador de Mukō-Gawa</p>
        <h2>{principal.nome}</h2>
        <div class="corpo">
          {principal.paragrafos.map((t) => <p>{t}</p>)}
        </div>
        <a class="perfil" href={principal.instagram.href} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="2.6" y="2.6" width="18.8" height="18.8" rx="5.4" />
            <circle cx="12" cy="12" r="4.2" />
            <circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none" />
          </svg>
          <span>Instagram de {principal.nome}</span>
          <span class="arroba">{principal.instagram.rotulo}</span>
        </a>
      </div>
    </div>
  </section>

  <hr class="regua" />

  <section class="secao">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">A arte</p></div>
        <h2>Quem desenha</h2>
      </div>

      <div class="dupla">
        {artistas.map((a) => (
          <article class="cartao">
            <div class="retrato retrato--menor">
              <Image src={a.img} alt={a.nome} widths={[320, 600]} sizes="(max-width: 760px) 88vw, 30vw" loading="lazy" />
              <span class="cantos" aria-hidden="true"></span>
            </div>
            <p class="rotulo">{a.papel}</p>
            <h3>{a.nome}</h3>
            <div class="corpo texto-cartao">
              {a.paragrafos.map((t) => <p>{t}</p>)}
            </div>
            <a class="perfil" href={a.instagram.href} target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
                <rect x="2.6" y="2.6" width="18.8" height="18.8" rx="5.4" />
                <circle cx="12" cy="12" r="4.2" />
                <circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none" />
              </svg>
              <span>Instagram de {a.nome}</span>
              <span class="arroba">{a.instagram.rotulo}</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  h1 { font-size: clamp(2.4rem, 6vw, 4.6rem); }

  .destaque {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(28px, 5vw, 66px);
    align-items: start;
  }

  .retrato { position: relative; }
  .retrato :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    clip-path: polygon(20px 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%, 0 20px);
    transition: filter .4s ease;
  }
  .retrato:hover :global(img) { filter: grayscale(0) contrast(1.08); }
  .retrato .cantos {
    position: absolute; inset: -10px;
    pointer-events: none;
    background:
      linear-gradient(var(--sangue), var(--sangue)) 0 0 / 1px 38px no-repeat,
      linear-gradient(var(--sangue), var(--sangue)) 0 0 / 38px 1px no-repeat,
      linear-gradient(var(--sangue), var(--sangue)) 100% 100% / 1px 38px no-repeat,
      linear-gradient(var(--sangue), var(--sangue)) 100% 100% / 38px 1px no-repeat;
  }

  .texto h2 { margin: 16px 0 22px; font-size: clamp(2rem, 4vw, 3.2rem); }

  /* Os dois cartões são idênticos em estrutura: mesma largura de imagem,
     mesmo ritmo vertical e botão colado na base, para os textos de tamanhos
     diferentes não desalinharem nada. */
  .dupla {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 60px);
    align-items: stretch;
  }
  .cartao {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .cartao .rotulo { margin-top: 24px; }
  .cartao h3 { margin: 8px 0 16px; }
  .texto-cartao { flex: 1 1 auto; }

  /* Os artistas nunca aparecem maiores que o criador. */
  .retrato--menor { width: 100%; max-width: 340px; }

  @media (max-width: 760px) {
    .dupla { grid-template-columns: 1fr; }
  }

  /* Botão de perfil padronizado: mesmo formato para os três. */
  .perfil {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 50px;
    margin-top: 26px;
    padding: 0 20px;
    border: 1px solid var(--linha-forte);
    color: var(--cinza);
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: .82rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    text-decoration: none;
    clip-path: polygon(12px 0, 100% 0, 100% calc(100% - 12px), calc(100% - 12px) 100%, 0 100%, 0 12px);
    transition: color .2s ease, border-color .2s ease, background .2s ease;
  }
  .perfil:hover { color: var(--osso); border-color: var(--osso); background: rgba(255,255,255,.05); }
  .perfil .arroba { color: var(--poeira); }
  .cartao .perfil { align-self: flex-start; margin-top: 26px; }

  @media (max-width: 880px) {
    .destaque { grid-template-columns: 1fr; }
    .destaque .retrato { max-width: 340px; }
  }
</style>
