---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Anuncio from "../components/Anuncio.astro";
import GradePersonagens from "../components/GradePersonagens.astro";
import ListaEspera from "../components/ListaEspera.astro";
import GostoDaNarrativa from "../components/GostoDaNarrativa.astro";
import { personagens, CLASSES } from "../data/personagens";

import manga from "../assets/formatos/manga.jpg";
import livros from "../assets/formatos/livros.jpg";
import anime from "../assets/formatos/anime.jpg";
import guerra from "../assets/historia/guerra-pela-humanidade.jpg";

const formatos = [
  {
    nome: "Mangá",
    selo: "Primeiro volume // Dezembro de 2026",
    img: manga,
    texto:
      "A narrativa serializada da guerra, publicada volume a volume a partir de dezembro de 2026.",
    destaque: true,
  },
  {
    nome: "Livros",
    selo: "Série começa em 2027",
    img: livros,
    texto:
      "O ciclo de livros está escrito e concluído. Um volume será lançado por vez, na ordem de leitura, a partir de 2027.",
    destaque: false,
  },
  {
    nome: "Anime",
    selo: "Em desenvolvimento // Ainda sem produção",
    img: anime,
    texto:
      "A adaptação animada é o sonho por trás deste projeto. Ela só se torna possível se os livros e o mangá forem bem — e qualquer notícia de estúdio, equipe ou elenco será anunciada aqui primeiro.",
    destaque: false,
  },
];
---

<Base
  titulo="Mukō-Gawa"
  descricao="Uma fantasia sombria em três formas. Mangá, livros e o projeto de anime de Mukō-Gawa, uma imersão na mitologia cristã. Primeiro volume em dezembro de 2026."
  colado
>
  <Hero />
  <Anuncio />

  <!-- ================= três formas ================= -->
  <section class="secao">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">Uma narrativa</p></div>
        <h2>Três formas, uma narrativa</h2>
      </div>

      <div class="formatos">
        {formatos.map((f) => (
          <article class:list={["formato", { "formato--destaque": f.destaque }]}>
            <div class="moldura">
              <Image
                src={f.img}
                alt={f.nome}
                widths={[420, 780]}
                sizes="(max-width: 820px) 92vw, 32vw"
                loading="lazy"
              />
              <span class="veu" aria-hidden="true"></span>
            </div>
            <p class="rotulo selo">{f.selo}</p>
            <h3>{f.nome}</h3>
            <p class="texto">{f.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <GostoDaNarrativa />

  <!-- ================= a historia ================= -->
  <section class="secao narrativa">
    <div class="envelope duplo">
      <div class="lado-texto">
        <div class="cabecalho-secao">
          <div class="topo"><p class="rotulo">A história</p></div>
          <h2>Antes da história, uma civilização entrou em guerra pela forma do mundo.</h2>
        </div>
        <p class="lead">
          Mukō-Gawa acompanha uma guerra civil entre um povo proto-humano que
          disputa um plano interdimensional — a dobra entre o que é e o que foi
          prometido. Duas ordens nascem de uma mesma linhagem: a que quer manter
          o plano fechado e a que quer rompê-lo.
        </p>
        <p class="acao"><a class="link-varre" href="/historia">Saber mais</a></p>
      </div>

      <div class="lado-arte">
        <Image
          src={guerra}
          alt="A Guerra pela Humanidade"
          widths={[520, 900]}
          sizes="(max-width: 900px) 92vw, 46vw"
          loading="lazy"
        />
        <span class="cantos" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <hr class="regua" />

  <!-- ================= personagens ================= -->
  <section class="secao">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo">
          <p class="rotulo">O elenco</p>
        </div>
        <div class="linha-titulo">
          <h2>Personagens</h2>
          <a class="link-varre" href="/personagens">Todos os personagens</a>
        </div>
      </div>

      <GradePersonagens lista={personagens} />
    </div>
  </section>

  <hr class="regua" />

  <!-- ================= as nove classes ================= -->
  <section class="secao classes">
    <div class="envelope">
      <div class="cabecalho-secao">
        <div class="topo"><p class="rotulo">A Hoste</p></div>
        <h2>As Nove Classes</h2>
        <p class="lead">As ordens da Hoste, reveladas uma por vez.</p>
      </div>

      <ol class="lista-classes">
        {CLASSES.map((c) => (
          <li>
            <span class="kanji" aria-hidden="true">{c.kanji}</span>
            <span class="num">{c.num}</span>
            <span class="nome">{c.nome}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <ListaEspera />
</Base>

<style>
  /* ---------- três formas ---------- */
  .formatos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: clamp(20px, 2.6vw, 38px);
  }
  /* Os três cards seguem o mesmo ritmo vertical mesmo quando o selo
     quebra em duas linhas, senão os títulos desalinham. */
  .formato { display: flex; flex-direction: column; }
  .formato h3 { margin: 8px 0 12px; }
  .formato .selo {
    margin-bottom: 14px;
    min-height: 2.6em;
    display: flex;
    align-items: flex-start;
  }
  .formato .texto { color: var(--cinza); font-size: .98rem; }
  .formato--destaque .selo { color: var(--sangue-vivo); }

  .moldura {
    position: relative;
    background: var(--vazio);
    isolation: isolate;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-bottom: 20px;
    border: 1px solid var(--linha);
    clip-path: polygon(16px 0, 100% 0, 100% calc(100% - 16px), calc(100% - 16px) 100%, 0 100%, 0 16px);
  }
  /* As artes já vêm encaixadas inteiras numa moldura 4:3 de fundo preto,
     então "cover" não corta nada. O blend faz o fundo sumir. */
  .moldura :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    mix-blend-mode: screen;
    transition: transform .6s cubic-bezier(.16,.84,.28,1);
  }
  .moldura .veu {
    position: absolute; inset: 0;
    background: linear-gradient(0deg, color-mix(in srgb, var(--tinta) 88%, transparent), transparent 58%);
  }
  .formato:hover .moldura :global(img) { transform: scale(1.04); }
  .formato--destaque .moldura { border-color: color-mix(in srgb, var(--sangue) 55%, transparent); }

  /* ---------- narrativa ---------- */
  .duplo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 76px);
    align-items: center;
  }
  .narrativa h2 { font-size: clamp(1.7rem, 3vw, 2.9rem); }
  .acao { margin-top: 26px; }

  .lado-arte { position: relative; }
  .lado-arte :global(img) {
    width: 100%;
    filter: grayscale(1) contrast(1.06);
    clip-path: polygon(20px 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%, 0 20px);
  }
  .lado-arte .cantos {
    position: absolute; inset: -10px;
    pointer-events: none;
    background:
      linear-gradient(var(--sangue), var(--sangue)) 0 0 / 1px 40px no-repeat,
      linear-gradient(var(--sangue), var(--sangue)) 0 0 / 40px 1px no-repeat,
      linear-gradient(var(--sangue), var(--sangue)) 100% 100% / 1px 40px no-repeat,
      linear-gradient(var(--sangue), var(--sangue)) 100% 100% / 40px 1px no-repeat;
  }

  .linha-titulo {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }

  /* ---------- classes ---------- */
  /* 3x3 fixo: nove itens sempre fecham a grade, nenhum bloco fica maior. */
  .lista-classes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--linha);
    border: 1px solid var(--linha);
  }
  .lista-classes li {
    position: relative;
    display: grid;
    gap: 6px;
    padding: 26px 22px 24px;
    background: var(--tinta);
    overflow: hidden;
    transition: background .3s ease;
  }
  .lista-classes li:hover { background: var(--tinta-2); }
  .lista-classes .kanji {
    position: absolute;
    right: -6px;
    bottom: -22px;
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: 5.4rem;
    line-height: 1;
    color: #fff;
    opacity: .05;
    transition: opacity .3s ease, transform .4s cubic-bezier(.16,.84,.28,1);
  }
  .lista-classes li:hover .kanji { opacity: .12; transform: translateY(-4px); }
  .lista-classes .num {
    font-family: var(--fonte-ui);
    font-weight: 600;
    font-size: .72rem;
    letter-spacing: .3em;
    color: var(--sangue-vivo);
  }
  .lista-classes .nome {
    font-family: var(--fonte-display);
    font-weight: 700;
    font-size: clamp(.95rem, 1.6vw, 1.22rem);
    color: var(--osso);
  }
  @media (max-width: 620px) {
    .lista-classes li { padding: 18px 12px 16px; }
    .lista-classes .kanji { font-size: 3.4rem; }
  }

  @media (max-width: 900px) {
    .duplo { grid-template-columns: 1fr; }
    .lado-arte { order: -1; }
  }
</style>
