---
import Personagem from "../../../paginas/Personagem.astro";
import { personagens } from "../../../data/personagens";

export function getStaticPaths() {
  return personagens.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
---
<Personagem idioma="en" slug={slug!} />
